---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter headings (e.g., only h2 and h3)
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc sticky top-24">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--muted)] mb-4">Inhalt</h2>
    <ul class="space-y-2 text-sm border-l border-[color:var(--line)]">
      {filteredHeadings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class:list={[
              "block py-1 pl-4 border-l-2 border-transparent transition-colors hover:text-[color:var(--accent-strong)] hover:border-[color:var(--accent)]",
              heading.depth === 2 ? "text-[color:var(--ink)]" : "text-[color:var(--muted)] pl-8"
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
