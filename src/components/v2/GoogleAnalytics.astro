---
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{GA_ID && (
  <script define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    // gtag.js erwartet das echte Arguments-Objekt — Rest-Params brechen das Tracking
    // eslint-disable-next-line prefer-rest-params
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;

    // Einmalige Initialisierung über die gesamte SPA-Session (Astro View Transitions
    // führen das Script pro Navigation erneut aus).
    if (!window.gtagInitialized) {
      window.gtagInitialized = true;

      // Consent Mode v2 "Advanced": gtag.js lädt sofort. Ohne Zustimmung sendet GA nur
      // cookielose Pings (keine Client-ID, keine Cookies); erst nach "Akzeptieren"
      // werden Analytics-Cookies gesetzt. Werbe-Signale bleiben dauerhaft aus.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });

      // Bereits gespeicherte Zustimmung (z. B. nach Reload) vor dem ersten Hit anwenden.
      if (typeof localStorage !== 'undefined' && localStorage.getItem('cookie-consent') === 'granted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }

      gtag('js', new Date());

      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);

      // Eigene Besuche markieren: einmal ?intern=1 aufrufen (dauerhaft), ?intern=0 hebt
      // es auf. GA filtert traffic_type=internal über den Datenfilter "Internal Traffic".
      const internParam = new URLSearchParams(location.search).get('intern');
      try {
        if (internParam === '1') localStorage.setItem('ga-internal', '1');
        if (internParam === '0') localStorage.removeItem('ga-internal');
      } catch { /* Storage blockiert: dann eben nicht markieren */ }
      let isInternal = false;
      try { isInternal = localStorage.getItem('ga-internal') === '1'; } catch { /* s. o. */ }

      // config bei jedem Seitenwechsel senden — sonst zählt GA bei View-Transition-
      // Navigation keinen neuen Pageview. astro:page-load feuert auch beim Erstaufruf.
      document.addEventListener('astro:page-load', () => {
        gtag('config', GA_ID, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
          ...(isInternal ? { traffic_type: 'internal' } : {}),
        });
      });
    }
  </script>
)}
