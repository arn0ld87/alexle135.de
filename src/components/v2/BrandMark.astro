---
/**
 * Bildmarke als Inline-SVG (D-22). Die Geometrie stammt aus public/brand/as-mark.svg;
 * die festen Farben der Lieferung werden nicht übernommen: der Körper erbt die
 * Textfarbe (currentColor), der Keil liest den Akzent. Beide Varianten (Papier und
 * Bauplan) bleiben damit sichtbar. Die Datei unter public/brand/ bleibt unverändert
 * (Favicon, feste URLs).
 */
interface Props {
  class?: string;
  /** true (Standard): reine Dekoration, vor Hilfstechnik verborgen. */
  decorative?: boolean;
}

const { class: className, decorative = true } = Astro.props;
const a11y = decorative
  ? { 'aria-hidden': 'true' as const, focusable: 'false' as const }
  : { role: 'img' as const, 'aria-label': 'Alexander Schneider' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  class={className}
  {...a11y}
>
  <path
    fill="currentColor"
    d="M195.5 117.2C186.83 92.98 170.63 73.4 142.5 73.4C104.5 73.4 68 108.67 68 147L68 172.5A24 24 0 0 0 92 196.5L100 196.5A14 14 0 0 1 114 210.5A14 14 0 0 1 100 224.5L30 224.5A14 14 0 0 1 16 210.5L16 142A124.2 114.6 0 0 1 140.3 27.4C171.93 27.4 201.35 36.02 224.02 59.03C231.95 67.08 238 75.45 238 87L238 96.87Z"
  ></path>
  <path
    fill="var(--accent)"
    d="M156 213.4L156 220.5A4 4 0 0 0 160 224.5L234 224.5A4 4 0 0 0 238 220.5L238 120.16A3 3 0 0 0 234.39 117.22A98.2 98.2 0 0 0 156 213.4Z"
  ></path>
</svg>
