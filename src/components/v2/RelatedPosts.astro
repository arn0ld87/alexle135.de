---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Heading-Stufe passend zur umgebenden Seitenhierarchie (Artikel nutzt h1 im header, h2 im FAQ). */
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const dateFormatter = new Intl.DateTimeFormat('de-DE', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

{posts.length > 0 && (
  <section
    class="mt-20 space-y-8 border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_12%,transparent)] pt-12"
    aria-labelledby="related-posts-title"
  >
    <div class="space-y-4">
      <p class="v2-kicker">Weiterlesen</p>
      <Heading
        id="related-posts-title"
        class="font-editorial text-[clamp(2.4rem,4.5vw,3.6rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)]"
      >
        Ähnliche Artikel
      </Heading>
    </div>

    <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => {
        const formattedDate = post.data.publishedAt
          ? dateFormatter.format(post.data.publishedAt)
          : null;

        return (
          <li class="border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] pt-6">
            <a
              href={`/blog/${post.id}/`}
              class="group block space-y-3 transition duration-200 hover:text-[color:var(--color-mono-50)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-neon-orange)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-mono-950)]"
            >
              {formattedDate && (
                <time
                  datetime={post.data.publishedAt?.toISOString()}
                  class="font-mono text-[0.76rem] uppercase tracking-[0.16em] text-[color:var(--color-mono-400)]"
                >
                  {formattedDate}
                </time>
              )}
              <p class="font-editorial text-[clamp(1.4rem,2.4vw,1.9rem)] leading-[1.05] tracking-[-0.03em] text-[color:var(--color-mono-50)] transition group-hover:text-[color:var(--color-neon-orange)]">
                {post.data.title}
              </p>
              <p class="max-w-[45ch] text-sm leading-7 text-[color:var(--color-mono-300)]">
                {post.data.summary}
              </p>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
