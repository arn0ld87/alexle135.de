---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Heading-Stufe passend zur umgebenden Seitenhierarchie (Artikel nutzt h1 im header, h2 im FAQ). */
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const dateFormatter = new Intl.DateTimeFormat('de-DE', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

{posts.length > 0 && (
  <section
    class="mt-20 space-y-8 border-t border-[color:var(--line)] pt-12"
    aria-labelledby="related-posts-title"
  >
    <div class="space-y-4">
      <p class="ds-kicker">Weiterlesen</p>
      <Heading
        id="related-posts-title"
        class="ds-display-m text-[color:var(--ink)]"
      >
        Ähnliche Artikel
      </Heading>
    </div>

    <ul>
      {posts.map((post) => {
        const formattedDate = post.data.publishedAt
          ? dateFormatter.format(post.data.publishedAt)
          : null;

        return (
          <li class="ds-row">
            <a
              href={`/blog/${post.id}/`}
              class="ds-row__content block space-y-3 md:grid md:grid-cols-[8.5rem_minmax(0,1fr)] md:gap-6 md:space-y-0"
            >
              {formattedDate && (
                <time
                  datetime={post.data.publishedAt?.toISOString()}
                  class="ds-meta block"
                >
                  {formattedDate}
                </time>
              )}
              <div class="space-y-3 md:col-start-2">
                <p class="ds-row__title ds-display-s">
                  {post.data.title}
                </p>
                <p class="max-w-[65ch] text-[length:var(--ds-text-sm)] leading-[1.55] text-[color:var(--muted)]">
                  {post.data.summary}
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
