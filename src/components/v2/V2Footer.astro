---
// V2Footer.astro
// Panel-Fläche (Systemwerk, 02-UI-SPEC "Footer"). Die Betriebszeile zeigt nur Fakten aus
// dem Build (Kurz-SHA und Datum über getBuildInfo), keinen Live-Zustand (D-21, D-46).
import { ArrowUp } from 'lucide-astro';
import LinkedInBadge from './LinkedInBadge.astro';
import logoNameMono from '../../../public/brand/as-logo-name-mono.svg?raw';
import { getBuildInfo } from '../../lib/buildInfo';

const currentYear = new Date().getFullYear();
const build = getBuildInfo();
const hasBuild = Boolean(build.sha || build.dateDisplay);
// Ohne SHA nur „Build “ + Datum; der SHA ist reiner Text, kein Link (UI-SPEC R-21).
const buildLead = build.sha ? (build.dateDisplay ? `Build ${build.sha} · ` : `Build ${build.sha}`) : 'Build ';

const REPO_URL = 'https://github.com/arn0ld87/alexle135.de';

const navigation = [
  { href: '/', label: 'Start' },
  { href: '/leistungen/', label: 'Was ich kann' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/kompetenzen/', label: 'Kompetenzen' },
  { href: '/apps/', label: 'Apps' },
  { href: '/blog/', label: 'Blog' },
  { href: '/certifications/', label: 'Zertifikate' },
];

const social = [
  { href: 'https://github.com/arn0ld87', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/alexander-schneider-9a8b38379', label: 'LinkedIn' },
  { href: 'https://www.threads.net/@alexle135', label: 'Threads' },
  { href: 'https://www.instagram.com/alexxaar87', label: 'Instagram' },
  { href: 'https://www.facebook.com/AlexLE135', label: 'Facebook' },
];

const system = [
  { href: '/status/', label: 'Status', external: false },
  { href: '/changelog/', label: 'Changelog', external: false },
  { href: REPO_URL, label: 'Quellcode', external: true },
  { href: '/legal/impressum/', label: 'Impressum', external: false },
  { href: '/legal/datenschutz/', label: 'Datenschutz', external: false },
  { href: '', label: 'Cookie-Einstellungen', external: false, action: true },
];

// Gemeinsame Link-Klassen: auf dem Panel gelten nur Panel-Tokens (RAHMEN 4).
const linkClass =
  'font-mono text-[0.85rem] text-[color:var(--panel-text)] underline-offset-4 decoration-[color:var(--panel-accent)] hover:underline focus-visible:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--panel-accent)]';
const headingClass = 'font-mono text-xs uppercase tracking-[0.08em] text-[color:var(--panel-muted)]';
---

<footer
  data-surface="panel"
  class="border-t border-[color:var(--panel-rule)] bg-[color:var(--panel)] pt-20 pb-12 text-[color:var(--panel-text)]"
>
  <div class="v2-shell">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
      <!-- Marke und Kontakt -->
      <div class="space-y-8">
        <!-- Inline, damit currentColor der Panel-Schrift folgt (img erbt sie nicht). Accessible Name kommt aus dem svg-title. -->
        <div
          class="w-full max-w-[14rem] text-[color:var(--panel-text)] [&>svg]:block [&>svg]:h-auto [&>svg]:w-full"
          set:html={logoNameMono}
        />
        <h2 class="max-w-[12ch] ds-display-l text-[color:var(--panel-text)]">Lass uns Systeme bauen.</h2>

        <div class="flex flex-col items-start gap-4">
          <p class="font-mono text-[0.8rem] leading-6 text-[color:var(--panel-muted)]">
            Leipzig, Deutschland <br />
            Remote-Arbeit möglich.
          </p>
          <a
            href="mailto:schneider@alex-schneider.dev"
            class="group inline-flex items-center gap-3 border-b border-[color:var(--panel-edge)] pb-1 transition-colors hover:border-[color:var(--panel-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--panel-accent)]"
          >
            <span class="font-mono text-[0.85rem] uppercase tracking-[0.15em] text-[color:var(--panel-text)]">
              schneider@alex-schneider.dev
            </span>
            <svg
              class="ds-icon h-4 w-4 text-[color:var(--panel-muted)] transition-transform duration-300 group-hover:translate-x-1 group-hover:text-[color:var(--panel-accent)]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>

          <LinkedInBadge />
        </div>
      </div>

      <!-- Link-Spalten: mobil eine, ab 768 px drei -->
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="space-y-6">
          <h3 class={headingClass}>Navigation</h3>
          <ul class="space-y-4">
            {
              navigation.map((item) => (
                <li>
                  <a href={item.href} class={linkClass}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="space-y-6">
          <h3 class={headingClass}>Social</h3>
          <ul class="space-y-4">
            {
              social.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="me noopener noreferrer" class={linkClass}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="space-y-6">
          <h3 class={headingClass}>System</h3>
          <ul class="space-y-4">
            {
              system.map((item) => (
                <li>
                  {item.action ? (
                    <button type="button" class={linkClass} data-open-cookie-settings>
                      {item.label}
                    </button>
                  ) : item.external ? (
                    <a href={item.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                      {item.label}
                    </a>
                  ) : (
                    <a href={item.href} class={linkClass}>
                      {item.label}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Betriebszeile: Fakten aus dem Build, kein Live-Zustand -->
    <div class="mt-20 border-t border-[color:var(--panel-rule)] pt-8">
      <div
        class="flex flex-col items-start gap-x-4 gap-y-3 font-mono text-xs tracking-[0.08em] text-[color:var(--panel-muted)] md:flex-row md:flex-wrap md:items-center"
      >
        <p>&copy; {currentYear} Alexander Schneider</p>
        {
          hasBuild && (
            <>
              <span aria-hidden="true" class="hidden size-2 shrink-0 bg-[color:var(--panel-accent)] md:block" />
              <p>{buildLead}{build.dateDisplay && <time datetime={build.date ?? undefined}>{build.dateDisplay}</time>}</p>
            </>
          )
        }
        <span aria-hidden="true" class="hidden size-2 shrink-0 bg-[color:var(--panel-accent)] md:block"></span>
        <p>Astro SSR &middot; Docker &middot; Traefik &middot; Eigener Server</p>
        <a
          href="#top"
          class="inline-flex items-center gap-2 text-[color:var(--panel-text)] underline-offset-4 decoration-[color:var(--panel-accent)] hover:underline focus-visible:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--panel-accent)] md:ml-auto"
        >
          Nach oben
          <ArrowUp size={16} class="ds-icon" aria-hidden="true" focusable="false" />
        </a>
      </div>
    </div>
  </div>
</footer>
