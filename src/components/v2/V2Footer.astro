---
// V2Footer.astro
import LinkedInBadge from './LinkedInBadge.astro';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_12%,transparent)] bg-[color:var(--color-mono-950)] pt-20 pb-12">
  <div class="v2-shell">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
      
      <!-- Brand & CTA -->
      <div class="space-y-8">
        <img
          src="/brand/alexle135-logo-primary.svg"
          alt="alexle135 Logo"
          class="h-10 w-auto max-w-[14rem] opacity-95 sm:h-12"
          loading="lazy"
        />
        <h2 class="max-w-[12ch] text-balance font-editorial text-[clamp(2.75rem,1.5rem_+_3vw,4.25rem)] leading-[0.92] tracking-[-0.05em] text-[color:var(--color-mono-50)]">
          Lass uns Systeme bauen.
        </h2>
        
        <div class="flex flex-col items-start gap-4">
          <p class="font-mono text-[0.8rem] leading-6 text-[color:var(--color-mono-400)]">
            Leipzig, Deutschland <br />
            Remote-Arbeit möglich.
          </p>
          <a
            href="mailto:schneider@alexle135.de"
            class="group inline-flex items-center gap-3 border-b border-[color:var(--color-mono-300)] pb-1 transition-colors hover:border-[color:var(--color-neon-orange)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-neon-orange)] focus-visible:ring-offset-4 focus-visible:ring-offset-[color:var(--color-mono-950)]"
          >
            <span class="font-mono text-[0.85rem] uppercase tracking-[0.15em] text-[color:var(--color-mono-50)] transition-colors group-hover:text-[color:var(--color-neon-orange)]">
              schneider@alexle135.de
            </span>
            <svg class="h-4 w-4 text-[color:var(--color-mono-300)] transition-transform duration-300 group-hover:translate-x-1 group-hover:text-[color:var(--color-neon-orange)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>

          <LinkedInBadge />
        </div>
      </div>

      <!-- Links Grid -->
      <div class="grid grid-cols-2 gap-8 md:grid-cols-3">
        
        <div class="space-y-6">
          <h3 class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-[color:var(--color-mono-500)]">Navigation</h3>
          <ul class="space-y-4">
            <li><a href="/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Start</a></li>
            <li><a href="/leistungen/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Was ich kann</a></li>
            <li><a href="/projekte/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Projekte</a></li>
            <li><a href="/blog/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Blog</a></li>
            <li><a href="/certifications/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Zertifikate</a></li>
          </ul>
        </div>

        <div class="space-y-6">
          <h3 class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-[color:var(--color-mono-500)]">Social</h3>
          <ul class="space-y-4">
            <li><a href="https://github.com/arn0ld87" target="_blank" rel="me noopener noreferrer" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/alexander-schneider-9a8b38379" target="_blank" rel="me noopener noreferrer" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">LinkedIn</a></li>
            <li><a href="https://www.threads.net/@alexle135" target="_blank" rel="me noopener noreferrer" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Threads</a></li>
            <li><a href="https://www.instagram.com/alexxaar87" target="_blank" rel="me noopener noreferrer" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Instagram</a></li>
            <li><a href="https://www.facebook.com/AlexLE135" target="_blank" rel="me noopener noreferrer" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Facebook</a></li>
          </ul>
        </div>

        <div class="space-y-6">
          <h3 class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-[color:var(--color-mono-500)]">Legal</h3>
          <ul class="space-y-4">
            <li><a href="/legal/impressum/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Impressum</a></li>
            <li><a href="/legal/datenschutz/" class="font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">Datenschutz</a></li>
            <li>
              <a href="/status/" class="group flex w-max items-center gap-2 font-mono text-[0.85rem] text-[color:var(--color-mono-300)] transition-colors hover:text-[color:var(--color-mono-50)] focus:outline-none focus:text-[color:var(--color-neon-orange)]">
                Status
                <span class="h-1.5 w-1.5 bg-[color:var(--color-neon-orange)]"></span>
              </a>
            </li>
          </ul>
        </div>
        
      </div>
    </div>

    <!-- Sub Footer -->
    <div class="mt-20 border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] pt-8">
      <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-[color:var(--color-mono-500)]">
          &copy; {currentYear} Alexander Schneider.
        </p>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-[color:var(--color-mono-500)]">
          Astro SSR &middot; Docker &middot; Traefik &middot; Eigener Server
        </p>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-[color:var(--color-mono-500)]">
          Alle Systeme laufen.
        </p>
      </div>
    </div>
  </div>
</footer>
