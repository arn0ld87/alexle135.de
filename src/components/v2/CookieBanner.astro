---
// Rendered server-side but controlled client-side via localStorage
---

<section
  id="cookie-banner"
  aria-label="Cookie-Einstellungen"
  aria-live="polite"
  class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-[color:var(--color-mono-800)] bg-[#111010] px-4 py-4 sm:px-6"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs leading-relaxed text-[color:var(--color-mono-400)]">
      Wir nutzen Google Analytics, um die Nutzung dieser Seite anonym zu messen.
      Deine Daten werden nicht für Werbung genutzt.
      <a
        href="/legal/datenschutz/"
        class="ml-1 underline underline-offset-2 hover:text-[color:var(--color-neon-orange)] transition-colors"
      >Datenschutzerklärung</a>
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="cookie-reject"
        type="button"
        class="border border-[color:var(--color-mono-700)] px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-[color:var(--color-mono-400)] transition-colors hover:border-[color:var(--color-mono-500)] hover:text-[color:var(--color-mono-200)]"
      >
        Ablehnen
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="bg-[color:var(--color-neon-orange)] px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-[#2a1100] transition-opacity hover:opacity-90"
      >
        Akzeptieren
      </button>
    </div>
  </div>
</section>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  function hideBanner() {
    banner?.classList.add('hidden');
  }

  function updateConsent(decision: 'granted' | 'denied') {
    localStorage.setItem('cookie-consent', decision);
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', { analytics_storage: decision });
    }
    // GoogleAnalytics.astro lädt das Remote-Script erst, wenn dieses Event feuert.
    if (decision === 'granted') {
      window.dispatchEvent(new Event('ga-consent-granted'));
    }
    // Weitere consent-gegatete Drittanbieter (z. B. LinkedInBadge) ohne Reload informieren.
    window.dispatchEvent(new CustomEvent('cookie-consent-changed', { detail: decision }));
    hideBanner();
  }

  // Nur anzeigen, wenn noch keine Entscheidung getroffen wurde
  if (!localStorage.getItem('cookie-consent')) {
    banner?.classList.remove('hidden');
  }

  acceptBtn?.addEventListener('click', () => updateConsent('granted'));
  rejectBtn?.addEventListener('click', () => updateConsent('denied'));
</script>
