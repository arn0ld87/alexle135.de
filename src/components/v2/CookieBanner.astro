---
// Rendered server-side but controlled client-side via localStorage
---

<section
  id="cookie-banner"
  aria-label="Cookie-Einstellungen"
  aria-live="polite"
  class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-[color:var(--ink)] bg-[color:var(--paper)] px-4 py-4 sm:px-6"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs leading-relaxed text-[color:var(--ink)]">
      Wir messen die Nutzung dieser Seite mit Google Analytics: ohne Zustimmung
      nur cookielos und ohne Wiedererkennung, mit Zustimmung über Cookies.
      Deine Daten werden nicht für Werbung genutzt.
      <a
        href="/legal/datenschutz/"
        class="ml-1 underline decoration-[color:var(--accent)] decoration-1 underline-offset-4 hover:decoration-2"
      >Datenschutzerklärung</a>
    </p>
    <div class="flex shrink-0 gap-3">
      <button id="cookie-reject" type="button" class="axb" data-variant="secondary">
        Ablehnen
      </button>
      <button id="cookie-accept" type="button" class="axb" data-variant="primary">
        Akzeptieren
      </button>
    </div>
  </div>
</section>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  function hideBanner() {
    banner?.classList.add('hidden');
  }

  function updateConsent(decision: 'granted' | 'denied') {
    localStorage.setItem('cookie-consent', decision);
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', { analytics_storage: decision });
      // Der erste page_view ging noch ohne Einwilligung raus und zählt in GA4 nicht; nach Zustimmung neu senden.
      if (decision === 'granted') window.gtag('event', 'page_view');
    }
    // Weitere consent-gegatete Drittanbieter (z. B. LinkedInBadge) ohne Reload informieren.
    window.dispatchEvent(new CustomEvent('cookie-consent-changed', { detail: decision }));
    hideBanner();
  }

  // Nur anzeigen, wenn noch keine Entscheidung getroffen wurde
  if (!localStorage.getItem('cookie-consent')) {
    banner?.classList.remove('hidden');
  }

  // Erneutes Öffnen über den Footer-Link „Cookie-Einstellungen“ (Widerruf/Zustimmung jederzeit).
  document.addEventListener('click', (event) => {
    if ((event.target as Element | null)?.closest('[data-open-cookie-settings]')) {
      banner?.classList.remove('hidden');
    }
  });

  acceptBtn?.addEventListener('click', () => updateConsent('granted'));
  rejectBtn?.addEventListener('click', () => updateConsent('denied'));
</script>
