---
interface Props {
  number: string;
  title: string;
  href: string;
  summary: string;
  proofLine: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
  year?: string;
  dateTime?: string;
}

const { number, title, href, summary, proofLine, tags = [], image, imageAlt, year, dateTime } = Astro.props;
---

<article class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.58fr)] xl:grid-cols-[minmax(0,1fr)_minmax(22rem,0.5fr)] lg:items-start group">
  <div class="relative order-2 lg:order-1">
    <div class="pointer-events-none absolute left-0 top-0 z-10 -translate-y-8 text-[clamp(4.5rem,12vw,8.75rem)] leading-none tracking-[-0.11em] text-[color:color-mix(in_srgb,var(--color-mono-50)_14%,transparent)] md:-translate-x-2 md:-translate-y-10" aria-hidden="true">{number}</div>
    <a href={href} class="group/block block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-neon-orange)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-mono-950)]">
      <div class="overflow-hidden bg-[color:color-mix(in_srgb,var(--color-mono-50)_5%,transparent)] shadow-[var(--shadow-editorial)]">
        <div class="relative min-h-[18rem] border-y border-[color:color-mix(in_srgb,var(--color-mono-50)_14%,transparent)] bg-[color:var(--color-mono-950)] md:min-h-[28rem]">
          {image ? (
            <img src={image} alt={imageAlt ?? title} class="absolute inset-0 h-full w-full object-cover opacity-60 grayscale contrast-125 mix-blend-luminosity transition duration-700 group-hover/block:opacity-100 group-hover/block:grayscale-[50%] group-hover/block:mix-blend-normal" loading="lazy" decoding="async" />
          ) : (
            <div class="absolute inset-0 bg-[linear-gradient(135deg,color-mix(in_srgb,var(--color-mono-50)_6%,transparent),transparent_55%)]"></div>
          )}
          <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_0,transparent_24%,color-mix(in_srgb,var(--color-mono-50)_8%,transparent)_24%,color-mix(in_srgb,var(--color-mono-50)_8%,transparent)_24.25%,transparent_24.25%,transparent_76%,color-mix(in_srgb,var(--color-mono-50)_8%,transparent)_76%,color-mix(in_srgb,var(--color-mono-50)_8%,transparent)_76.25%,transparent_76.25%,transparent_100%)] pointer-events-none"></div>
          <div class="absolute inset-x-[10%] top-[18%] bottom-[16%] border border-[color:color-mix(in_srgb,var(--color-mono-50)_16%,transparent)] bg-[linear-gradient(180deg,color-mix(in_srgb,var(--color-mono-950)_60%,transparent),transparent_100%)] transition duration-300 group-hover/block:scale-[1.01] group-hover/block:border-[color:color-mix(in_srgb,var(--color-neon-orange)_34%,transparent)] pointer-events-none"></div>
          <div class="absolute bottom-[22%] right-[15%] h-[26%] w-[22%] border border-[color:color-mix(in_srgb,var(--color-mono-50)_12%,transparent)] bg-[color:color-mix(in_srgb,var(--color-mono-950)_80%,transparent)] backdrop-blur-sm pointer-events-none"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] px-5 py-4 md:px-6">
            <p class="font-ui text-[0.68rem] uppercase tracking-[0.26em] text-[color:var(--color-mono-200)]">Case entry</p>
            <span class="font-ui text-[0.68rem] uppercase tracking-[0.26em] text-[color:var(--color-neon-orange)] transition-colors group-hover/block:text-white">View project</span>
          </div>
        </div>
      </div>
    </a>
  </div>

  <div class="order-1 lg:order-2 grid gap-8 md:grid-cols-5 md:gap-6">
    <div class="space-y-5 md:col-span-3">
      <div class="flex items-start justify-between gap-4">
        <p class="v2-kicker">Project</p>
        {year && (dateTime ? (
          <time datetime={dateTime} class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[color:var(--color-mono-400)]">{year}</time>
        ) : (
          <span class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[color:var(--color-mono-400)]">{year}</span>
        ))}
      </div>
      <div class="space-y-4">
        <h2 class="font-editorial text-3xl leading-tight text-[color:var(--color-mono-50)] md:text-[2.35rem]">
          <a href={href} class="transition hover:text-[color:var(--color-neon-orange)]">{title}</a>
        </h2>
        <p class="text-base leading-8 text-[color:var(--color-mono-200)]">{summary}</p>
        <p class="border-l border-[color:color-mix(in_srgb,var(--color-neon-orange)_40%,transparent)] pl-4 font-mono text-[0.76rem] leading-6 text-[color:var(--color-mono-300)]">
          <span class="text-[color:var(--color-neon-orange)]">$</span> proves: {proofLine}
        </p>
      </div>
    </div>

    <div class="space-y-5 md:col-span-2">
      <p class="v2-kicker">Tech stack</p>
      <ul class="space-y-3">
        {tags.slice(0, 4).map((tech) => (
          <li class="border-b border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] pb-3 font-ui text-[0.82rem] uppercase tracking-[0.18em] text-[color:var(--color-mono-200)]">{tech}</li>
        ))}
      </ul>
    </div>
  </div>
</article>
