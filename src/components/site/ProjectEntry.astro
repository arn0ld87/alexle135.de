---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  number: string;
  title: string;
  href: string;
  summary: string;
  meinTeil: string;
  tags?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  year?: string;
  dateTime?: string;
}

const { number, title, href, summary, meinTeil, tags = [], image, imageAlt, year, dateTime } = Astro.props;
---

<article class="ds-card group grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.58fr)] xl:grid-cols-[minmax(0,1fr)_minmax(22rem,0.5fr)] lg:items-start">
  <div class="order-2 lg:order-1">
    <a href={href} class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--accent)]">
      <div class="overflow-hidden border border-[color:var(--line)] bg-[color:color-mix(in_srgb,var(--ink)_4%,var(--paper))]">
        {image && (
          <Picture
            src={image}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 800]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt={imageAlt ?? title}
            class="block aspect-[3/2] h-auto w-full object-contain"
            pictureAttributes={{ class: 'contents' }}
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="flex items-end justify-between gap-4 border-t border-[color:var(--line)] bg-[color:var(--paper)] px-5 py-4 md:px-6">
          <p class="ds-meta">Projekteintrag</p>
          <span class="ds-meta ds-meta--ink">Ansehen</span>
        </div>
      </div>
    </a>
  </div>

  <div class="order-1 lg:order-2 grid gap-8 md:grid-cols-5 md:gap-6">
    <div class="space-y-5 md:col-span-3">
      <div class="flex items-start justify-between gap-4">
        <p class="ds-kicker">Projekt <span aria-hidden="true">/ {number}</span></p>
        {year && (dateTime ? (
          <time datetime={dateTime} class="ds-meta">{year}</time>
        ) : (
          <span class="ds-meta">{year}</span>
        ))}
      </div>
      <div class="space-y-4">
        <h2 class="ds-display-s">
          <a href={href} class="transition-colors hover:text-[color:var(--accent-strong)]">{title}</a>
        </h2>
        <p class="text-[length:var(--ds-text-body)] leading-[1.55] text-[color:var(--ink)]">{summary}</p>
        <p class="border-l border-[color:var(--accent)] pl-4 font-mono text-[length:var(--ds-text-label)] leading-6 text-[color:var(--muted)]">
          <span class="text-[color:var(--accent-strong)]">Mein Teil:</span> {meinTeil}
        </p>
      </div>
    </div>

    <div class="space-y-5 md:col-span-2">
      <p class="ds-kicker">Tech-Stack</p>
      <ul class="flex flex-wrap gap-2">
        {tags.slice(0, 4).map((tech) => (
          <li class="ds-tag">{tech}</li>
        ))}
      </ul>
    </div>
  </div>
</article>
