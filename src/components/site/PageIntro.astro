---
interface Props {
  kicker: string;
  title: string;
  lead: string;
  aside?: string;
  accentDot?: boolean;
  /** Wort im Titel, das als Outline gesetzt wird (höchstens eines je Seite, D-14). */
  outlineWord?: string;
}

const { kicker, title, lead, aside, accentDot = true, outlineWord } = Astro.props;

const outlineAt = outlineWord ? title.indexOf(outlineWord) : -1;
---

<header class="ds-pagehead ds-linegrid grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.7fr)] lg:items-end">
  <div class="space-y-5">
    <p class="ds-kicker" data-marker={accentDot ? undefined : 'none'}>{kicker}</p>
    <h1 class="ds-pagehead__title ds-display-xl">
      {outlineAt === -1 || !outlineWord ? (
        title
      ) : (
        <Fragment>
          {title.slice(0, outlineAt)}<span class="ds-outline">{outlineWord}</span>{title.slice(outlineAt + outlineWord.length)}
        </Fragment>
      )}
    </h1>
    <p class="ds-pagehead__lead">
      {lead}
    </p>
  </div>

  {aside && (
    <p class="ds-pagehead__aside lg:justify-self-end">
      {aside}
    </p>
  )}
</header>
