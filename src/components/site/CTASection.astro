---
interface Props {
  kicker?: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  /** Wort im Titel, das in der Panel-Akzentfarbe gesetzt wird. */
  accentWord?: string;
}

const { kicker = 'Next step', title, body, primaryHref, primaryLabel, secondaryHref, secondaryLabel, accentWord } = Astro.props;

const accentAt = accentWord ? title.indexOf(accentWord) : -1;
---

<section
  class="ds-panel grid gap-8 px-6 py-12 md:px-12 md:py-16 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)] lg:items-end"
  data-surface="panel"
>
  <div class="space-y-5">
    <p class="ds-kicker">{kicker}</p>
    <h2 class="max-w-4xl ds-display-l text-[color:var(--panel-text)]">
      {accentAt === -1 || !accentWord ? (
        title
      ) : (
        <Fragment>
          {title.slice(0, accentAt)}<span class="text-[color:var(--panel-accent)]">{accentWord}</span>{title.slice(accentAt + accentWord.length)}
        </Fragment>
      )}
    </h2>
  </div>

  <div class="space-y-6 lg:justify-self-end">
    <p class="max-w-[34ch] text-[length:var(--ds-text-sm)] leading-[1.55] text-[color:var(--panel-muted)]">{body}</p>
    <div class="flex flex-wrap gap-4">
      <a href={primaryHref} class="axb" data-variant="primary">{primaryLabel}</a>
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="axb" data-variant="ghost">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>
