---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  when: string;
  action: string;
  result: string;
  deliverables?: string[];
  link?: { href: string; label: string };
  links?: { href: string; label: string }[];
}

const { index, eyebrow, title, when, action, result, deliverables, link, links } = Astro.props;
const resolvedLinks = links?.length ? links : link ? [link] : [];
---

<article class="ds-row grid gap-6 lg:grid-cols-[4.5rem_minmax(0,1.15fr)_minmax(16rem,0.95fr)] lg:gap-10">
  <p class="ds-meta">{index}</p>

  <div class="space-y-4">
    <p class="ds-kicker">{eyebrow}</p>
    <h2 class="max-w-4xl ds-display-l text-[color:var(--ink)]">{title}</h2>
    {deliverables && deliverables.length > 0 && (
      <ul class="space-y-2 pt-2">
        {deliverables.map((item) => (
          <li class="flex items-start gap-2 font-mono text-[length:var(--ds-text-label)] leading-5 tracking-[0.08em] text-[color:var(--muted)]">
            <span class="mt-1.5 h-1 w-1 shrink-0 bg-[color:var(--accent)]" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
    )}
    {resolvedLinks.length > 0 && (
      <div class="flex flex-wrap gap-4 pt-1">
        {resolvedLinks.map((item) => (
          <a href={item.href} class="ds-meta ds-meta--ink inline-flex items-center gap-2 underline decoration-[color:var(--accent)] decoration-1 underline-offset-4 hover:decoration-2">
            {item.label} <span class="text-[color:var(--accent-strong)]" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="space-y-4 border-l border-[color:var(--line)] pl-4 lg:pl-6">
    <p class="ds-meta">Wann sinnvoll</p>
    <p class="text-[length:var(--ds-text-sm)] leading-[1.55] text-[color:var(--ink)]">{when}</p>
    <p class="ds-meta">Was ich mache</p>
    <p class="text-[length:var(--ds-text-sm)] leading-[1.55] text-[color:var(--ink)]">{action}</p>
    <p class="ds-meta">Was besser wird</p>
    <p class="text-[length:var(--ds-text-sm)] leading-[1.55] text-[color:var(--muted)]">{result}</p>
  </div>
</article>
