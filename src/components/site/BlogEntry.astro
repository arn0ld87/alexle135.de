---
interface Props {
  date: string;
  dateTime?: string;
  title: string;
  href: string;
  summary: string;
  format?: string;
  readingTime?: string;
  snippet?: string;
}

const { date, dateTime, title, href, summary, format, readingTime, snippet } = Astro.props;
---

<article class="border-b border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] py-8 md:py-10">
  <a href={href} class="group grid gap-5 transition duration-200 hover:text-[color:var(--color-mono-50)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-neon-orange)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-mono-950)] md:grid-cols-[8.5rem_minmax(0,1fr)_7rem_6rem] md:gap-6">
    <div class="space-y-2">
      <p class="font-mono text-[0.76rem] uppercase tracking-[0.16em] text-[color:var(--color-mono-400)] md:hidden">Date</p>
      {dateTime ? (
        <time datetime={dateTime} class="font-mono text-[0.82rem] leading-6 text-[color:var(--color-mono-200)]">{date}</time>
      ) : (
        <span class="font-mono text-[0.82rem] leading-6 text-[color:var(--color-mono-200)]">{date}</span>
      )}
    </div>

    <div class="space-y-4">
      <h2 class="max-w-[22ch] font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.94] tracking-[-0.05em] text-[color:var(--color-mono-50)] transition group-hover:text-[color:var(--color-neon-orange)]">{title}</h2>
      <p class="max-w-[65ch] text-base leading-8 text-[color:var(--color-mono-200)]">{summary}</p>
      {snippet && (
        <pre class="max-w-[65ch] overflow-x-auto border-l border-[color:color-mix(in_srgb,var(--color-neon-orange)_40%,transparent)] pl-4 font-mono text-[0.76rem] leading-6 text-[color:var(--color-mono-300)]"><code><span class="text-[color:var(--color-neon-orange)]">$</span> open post.md
&gt; {snippet}</code></pre>
      )}
    </div>

    <div class="space-y-2">
      <p class="font-mono text-[0.76rem] uppercase tracking-[0.16em] text-[color:var(--color-mono-400)] md:hidden">Format</p>
      <p class="font-mono text-[0.82rem] uppercase tracking-[0.16em] text-[color:var(--color-mono-200)]">{format || 'Article'}</p>
    </div>

    <div class="space-y-2">
      <p class="font-mono text-[0.76rem] uppercase tracking-[0.16em] text-[color:var(--color-mono-400)] md:hidden">Read</p>
      <p class="font-mono text-[0.82rem] text-[color:var(--color-mono-200)]">{readingTime || '05 min'}</p>
    </div>
  </a>
</article>
