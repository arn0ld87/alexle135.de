---
interface Props {
  date: string;
  dateTime?: string;
  title: string;
  href: string;
  summary: string;
  format?: string;
  readingTime?: string;
  snippet?: string;
}

const { date, dateTime, title, href, summary, format, readingTime, snippet } = Astro.props;
---

<article class="ds-row">
  <a href={href} class="ds-row__content grid gap-5 md:grid-cols-[8.5rem_minmax(0,1fr)_7rem_6rem] md:gap-6">
    <div class="space-y-2">
      <p class="ds-meta md:hidden">Date</p>
      {dateTime ? (
        <time datetime={dateTime} class="ds-meta ds-meta--ink">{date}</time>
      ) : (
        <span class="ds-meta ds-meta--ink">{date}</span>
      )}
    </div>

    <div class="min-w-0 space-y-4">
      <h2 class="ds-row__title max-w-[22ch] ds-display-s">{title}</h2>
      <p class="max-w-[65ch] text-[length:var(--ds-text-body)] leading-[1.55] text-[color:var(--ink)]">{summary}</p>
      {snippet && (
        <pre class="max-w-[65ch] overflow-x-auto border-l border-[color:var(--line)] pl-4 font-mono text-[length:var(--ds-text-label)] leading-6 text-[color:var(--muted)]"><code><span class="text-[color:var(--accent-strong)]">$</span> open post.md
&gt; {snippet}</code></pre>
      )}
    </div>

    <div class="space-y-2">
      <p class="ds-meta md:hidden">Format</p>
      <p class="ds-meta ds-meta--ink">{format || 'Article'}</p>
    </div>

    <div class="space-y-2">
      <p class="ds-meta md:hidden">Read</p>
      <p class="ds-meta ds-meta--ink">{readingTime || '05 min'}</p>
    </div>
  </a>
</article>
