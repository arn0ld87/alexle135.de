---
import { getCollection, getEntry } from 'astro:content';
import V2Layout from '../layouts/V2Layout.astro';
import { isPublishedBlogPost } from '../utils/content';
import { selectProjects } from '../lib/home/works';
import { selectPosts } from '../lib/home/logbook';
import Hero from '../components/home/Hero.astro';
import Works from '../components/home/Works.astro';
import Approach from '../components/home/Approach.astro';
import Logbook from '../components/home/Logbook.astro';
import PreviewDialog from '../components/home/PreviewDialog.astro';
import TerminalBand from '../components/home/TerminalBand';
import Contact from '../components/home/Contact';
// Nur die Metadaten des Porträts für das JSON-LD (kein Bild-Dienst, kein Bild-Element):
// Die Startseite bleibt SSR und löst keine Bildtransformation aus (D-41).
import portrait from '../assets/portrait/alex-portrait.webp';

// Weitere Arbeiten: höchstens sechs Projekte, zuerst featured, dann nach Datum (works.ts).
const projectRows = selectProjects(await getCollection('projects'));
// Agora ist kein Projekt der Collection; Format, Datum und Link kommen aus diesem Blogpost (D-43).
const agoraEntry = await getEntry('blog', 'agora-mirofish-fork-local-first');
// Dieselbe Prüfung wie die Detailseite: ein Entwurf oder vordatierter Beitrag wird nicht beworben.
const agora = agoraEntry && isPublishedBlogPost(agoraEntry) ? agoraEntry : undefined;
// Logbuch: die acht neuesten veröffentlichten Beiträge (logbook.ts); Chips und Suche filtern nur diese.
const logbookRows = selectPosts(
  (await getCollection('blog')).filter(isPublishedBlogPost),
  8
);
---

<V2Layout
  title="DevOps & Systemintegration in Leipzig"
  description="Alexander Schneider aus Leipzig, angehender Fachinformatiker Systemintegration. Meine Projekte zu Linux, Docker, CI/CD, Automatisierung und KI."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://alex-schneider.dev/#person",
        "name": "Alexander Schneider",
        "url": "https://alex-schneider.dev/ueber-mich/",
        "image": new URL(portrait.src, Astro.site).href,
        "jobTitle": "Angehender Fachinformatiker Systemintegration",
        "address": { "@type": "PostalAddress", "addressLocality": "Leipzig", "addressCountry": "DE" },
        "sameAs": [
          "https://www.wikidata.org/wiki/Q139493022",
          "https://github.com/arn0ld87",
          "https://www.linkedin.com/in/alexander-schneider-9a8b38379",
          "https://www.xing.com/profile/Alexander_Schneider010923/web_profiles",
          "https://www.threads.net/@alexle135",
          "https://www.instagram.com/alexxaar87",
          "https://www.facebook.com/AlexLE135"
        ],
        "knowsAbout": ["DevOps", "Linux", "Docker", "CI/CD", "Systemintegration", "Automatisierung", "KI-Workflows", "Nginx", "systemd", "Proxmox"]
      },
      {
        "@type": "WebSite",
        "@id": "https://alex-schneider.dev/#website",
        "url": "https://alex-schneider.dev/",
        "name": "alex-schneider.dev – Alexander Schneider",
        "description": "Portfolio, Projekte und Blog von Alexander Schneider, angehender Fachinformatiker Systemintegration in Leipzig.",
        "inLanguage": "de-DE",
        "publisher": { "@id": "https://alex-schneider.dev/#person" }
      }
    ]
  }}
>
  <main class="ds-ground">
    <Hero />
    <Works rows={projectRows} agora={agora} />
    <Approach />
    <TerminalBand />
    <Logbook rows={logbookRows} />
    <Contact client:visible />
    {/* Ein Dialog für alle Vorschau-Buttons (Arbeiten und Logbuch). */}
    <PreviewDialog />
  </main>
</V2Layout>
