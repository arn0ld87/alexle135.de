---
import { getCollection } from 'astro:content';
import PageIntro from '../components/site/PageIntro.astro';
import V2Layout from '../layouts/V2Layout.astro';

export const prerender = true;

const entries = await getCollection('changelog');
entries.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const typeLabels: Record<string, string> = {
  architecture: 'Architektur',
  quality: 'Qualität',
  feature: 'Feature',
  operations: 'Betrieb',
};
---

<V2Layout
  title="Changelog – alex-schneider.dev"
  description="Technische Änderungen, Betriebsnotizen und sichtbare Qualitätsarbeit an alex-schneider.dev."
>
  <main class="v2-shell py-20 md:py-28">
    <PageIntro
      kicker="Changelog"
      title="Was sich technisch an der Seite bewegt."
      lead="Kurze, nachvollziehbare Updates zu Architektur, Betrieb, Qualität und nutzbaren Features."
      aside="Kein Release-Theater. Nur die Dinge, die helfen, den Zustand des Projekts einzuordnen."
    />

    <section class="mt-12 max-w-3xl space-y-3 text-sm leading-7 text-[color:var(--ink)] md:mt-16">
      <h2 class="ds-display-s">So lese ich diese Liste</h2>
      <p>
        Jeder Eintrag beschreibt eine Änderung an dieser Website, die man von außen nachvollziehen kann: Architektur, Betrieb, Qualitätssicherung oder ein neues Feature.
        Die Einträge sind nach Datum sortiert, das Label nennt die Art der Änderung. Wo es einen Beitrag oder ein Projekt dazu gibt, ist er verlinkt.
      </p>
      <p>
        Den aktuellen Betriebszustand zeigt die <a href="/status/" class="underline decoration-[color:var(--accent)] underline-offset-4">Statusseite</a>,
        den Code der <a href="https://github.com/arn0ld87/alexle135.de" class="underline decoration-[color:var(--accent)] underline-offset-4" rel="noopener noreferrer" target="_blank">Quellcode auf GitHub</a>.
        Ausführlichere Hintergründe stehen im <a href="/blog/" class="underline decoration-[color:var(--accent)] underline-offset-4">Logbuch</a>.
      </p>
    </section>

    <section class="mt-12 space-y-6 md:mt-16">
      {
        entries.map((entry) => (
          <article class="ds-row grid py-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
            <div class="ds-meta">
              <time datetime={entry.data.publishedAt.toISOString()}>
                {new Intl.DateTimeFormat('de-DE', {
                  day: '2-digit',
                  month: '2-digit',
                  year: 'numeric',
                }).format(entry.data.publishedAt)}
              </time>
              <span class="mt-2 block text-[color:var(--accent-strong)]">
                {typeLabels[entry.data.type] ?? entry.data.type}
              </span>
            </div>

            <div class="mt-4 md:mt-0">
              <h2 class="ds-display-s text-[color:var(--ink)]">
                {entry.data.title}
              </h2>
              <p class="mt-3 max-w-3xl text-sm leading-7 text-[color:var(--ink)]">
                {entry.data.summary}
              </p>
              {entry.data.links.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-3">
                  {entry.data.links.map((link) => (
                    <a
                      href={link.href}
                      class="ds-meta transition-colors hover:text-[color:var(--accent-strong)]"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </section>
  </main>
</V2Layout>

