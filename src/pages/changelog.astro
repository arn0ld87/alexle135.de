---
import { getCollection } from 'astro:content';
import PageIntro from '../components/site/PageIntro.astro';
import V2Layout from '../layouts/V2Layout.astro';

export const prerender = true;

const entries = await getCollection('changelog');
entries.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const typeLabels: Record<string, string> = {
  architecture: 'Architektur',
  quality: 'Qualitaet',
  feature: 'Feature',
  operations: 'Betrieb',
};
---

<V2Layout
  title="Changelog – alexle135.de"
  description="Technische Aenderungen, Betriebsnotizen und sichtbare Qualitaetsarbeit an alexle135.de."
>
  <main class="v2-shell py-20 md:py-28">
    <PageIntro
      kicker="Changelog"
      title="Was sich technisch an der Seite bewegt."
      lead="Kurze, nachvollziehbare Updates zu Architektur, Betrieb, Qualitaet und nutzbaren Features."
      aside="Kein Release-Theater. Nur die Dinge, die helfen, den Zustand des Projekts einzuordnen."
    />

    <section class="mt-12 space-y-6 md:mt-16">
      {
        entries.map((entry) => (
          <article class="border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_14%,transparent)] py-6 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-mono-500)]">
              <time datetime={entry.data.publishedAt.toISOString()}>
                {new Intl.DateTimeFormat('de-DE', {
                  day: '2-digit',
                  month: '2-digit',
                  year: 'numeric',
                }).format(entry.data.publishedAt)}
              </time>
              <span class="mt-2 block text-[color:var(--color-neon-orange)]">
                {typeLabels[entry.data.type] ?? entry.data.type}
              </span>
            </div>

            <div class="mt-4 md:mt-0">
              <h2 class="font-editorial text-2xl leading-tight text-[color:var(--color-mono-50)]">
                {entry.data.title}
              </h2>
              <p class="mt-3 max-w-3xl text-sm leading-7 text-[color:var(--color-mono-200)]">
                {entry.data.summary}
              </p>
              {entry.data.links.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-3">
                  {entry.data.links.map((link) => (
                    <a
                      href={link.href}
                      class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-mono-500)] transition-colors hover:text-[color:var(--color-neon-orange)]"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </section>
  </main>
</V2Layout>

