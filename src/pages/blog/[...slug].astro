---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import V2Layout from '../../layouts/V2Layout.astro';
import RelatedPosts from '../../components/v2/RelatedPosts.astro';
import { getReadingTime } from '../../utils/readingTime';
import { getRelatedPosts, isPublishedBlogPost } from '../../utils/content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublishedBlogPost);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { slug } = Astro.params;
let post: CollectionEntry<'blog'> | undefined = Astro.props.post;

if (!post && slug) {
  post = await getEntry('blog', slug);
}

// Gleiche Publish-Regel wie getStaticPaths (Draft + Future-Date-Guard), statt
// nur draft zu prüfen — sonst wären zukünftig datierte Posts direkt erreichbar.
if (!post || !isPublishedBlogPost(post)) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);

const formattedDate = post.data.publishedAt
  ? new Intl.DateTimeFormat('de-DE', {
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
    }).format(new Date(post.data.publishedAt))
  : null;

const readingTime = post.data.readingTime || getReadingTime(post.body || '');
const isFeature = post.data.layout === 'feature';

const allPosts = await getCollection('blog');
const relatedPosts = getRelatedPosts(post, allPosts);

// Schema — BlogPosting + optional FAQPage, zusammengefasst im @graph
const blogPostingNode = {
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.summary,
  "author": { "@id": "https://alex-schneider.dev/#person" },
  "publisher": { "@id": "https://alex-schneider.dev/#person" },
  "datePublished": post.data.publishedAt,
  "dateModified": post.data.updatedAt ?? post.data.publishedAt,
  "image": post.data.heroImage ? new URL(post.data.heroImage.src, Astro.site).toString() : undefined,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).toString()
  }
};

const faqNode = post.data.faq && post.data.faq.length > 0
  ? {
      "@type": "FAQPage",
      "mainEntity": post.data.faq.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer,
        },
      })),
    }
  : null;

const schemas = {
  "@context": "https://schema.org",
  "@graph": faqNode ? [blogPostingNode, faqNode] : [blogPostingNode],
};
---

<V2Layout
  title={post.data.title}
  description={post.data.metaDescription ?? post.data.summary}
  ogSlug={post.id}
  schema={schemas}
  ogType="article"
  publishedTime={post.data.publishedAt?.toISOString()}
  modifiedTime={(post.data.updatedAt ?? post.data.publishedAt)?.toISOString()}
  imageAlt={post.data.heroImageAlt ?? post.data.title}
>
  <div
    id="reading-progress"
    class="fixed inset-x-0 top-0 z-[60] h-[3px] origin-left scale-x-0 bg-[color:var(--accent)] motion-reduce:hidden"
    aria-hidden="true"
  ></div>

  <main>
  <article
    class:list={[
      'mx-auto w-full px-6 py-20 md:px-10 md:py-28',
      isFeature ? 'feature-article max-w-[90rem]' : 'max-w-[var(--shell-narrow)]',
    ]}
    data-layout={post.data.layout}
  >
    
    <header
      class:list={[
        'ds-pagehead mb-16 space-y-8',
        isFeature && 'blog-feature-header',
      ]}
    >
      <p class="ds-kicker">BLOG</p>

      <h1 class:list={[
        'ds-display-l text-[color:var(--ink)]',
        isFeature && 'max-w-[14ch]',
      ]}>
        {post.data.title}
      </h1>

      <p class:list={[
        'max-w-[60ch] text-[length:var(--ds-text-body)] leading-[1.55] text-[color:var(--ink)]',
        isFeature && 'md:text-[length:1.25rem]',
      ]}>
        {post.data.summary}
      </p>

      <div class="ds-meta flex flex-wrap items-center gap-x-4 gap-y-2">
        {formattedDate && <time datetime={post.data.publishedAt?.toISOString()}>{formattedDate}</time>}
        <span class="text-[color:var(--accent-strong)]">/</span>
        <span>{readingTime}</span>
        <span class="text-[color:var(--accent-strong)]">/</span>
        <span>{post.data.format || 'Article'}</span>
      </div>

      {post.data.tags && (
        <ul class="flex flex-wrap gap-3 pt-4">
          {post.data.tags.map((tag) => (
             <li class="ds-tag">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    {isFeature && post.data.heroVideo && (
      <figure class="feature-video mb-16 border border-[color:color-mix(in_srgb,var(--ink)_14%,transparent)] bg-[color:var(--paper)] p-2">
        <video
          src={post.data.heroVideo}
          poster={(post.data.heroPoster ?? post.data.heroImage)?.src}
          class="aspect-video w-full bg-[color:var(--panel)] object-cover"
          data-surface="panel"
          controls
          muted
          playsinline
          preload="metadata"
          aria-label={`Produktdemo: ${post.data.title}`}
        >
          <a href={post.data.heroVideo}>Produktdemo öffnen</a>
        </video>
        <figcaption class="flex flex-wrap justify-between gap-2 px-2 py-3 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[color:var(--muted)]">
          <span>Produktdemo / Original-UI</span>
          <span>18 Sekunden / ohne Werberendering</span>
        </figcaption>
      </figure>
    )}

    <div class:list={[isFeature && 'blog-feature-body mx-auto max-w-4xl']}>

    {post.data.tldr && (
      <section
        class="mb-16 border-y border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] py-8 md:grid md:grid-cols-[10rem_minmax(0,1fr)] md:gap-8"
        aria-labelledby="tldr-title"
        data-aeo="summary"
      >
        <div class="pb-4 md:pb-0">
          <p
            id="tldr-title"
            class="font-mono text-xs uppercase tracking-[0.2em] text-[color:var(--accent-strong)]"
          >
            TL;DR
          </p>
        </div>
        <p class="max-w-[65ch] text-lg leading-8 text-[color:var(--ink)]">
          {post.data.tldr}
        </p>
      </section>
    )}

    {post.data.heroImage && (!isFeature || !post.data.heroVideo) && (
      <figure class="mb-16 border border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] p-2">
         <Picture
           src={post.data.heroImage}
           formats={['avif', 'webp']}
           fallbackFormat="webp"
           widths={[640, 960, 1440]}
           sizes="(min-width: 1280px) 1200px, 100vw"
           alt={post.data.heroImageAlt ?? post.data.title}
           class="w-full h-auto aspect-video object-cover grayscale-[20%] contrast-125"
           pictureAttributes={{ class: 'block' }}
           loading="eager"
           fetchpriority="high"
           decoding="async"
         />
      </figure>
    )}

    <div class:list={['v2-prose', isFeature && 'feature-prose']}>
      <Content />
    </div>

    {post.data.faq && post.data.faq.length > 0 && (
      <section class="mt-20 space-y-8 border-t border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pt-12" aria-labelledby="faq-title">
        <div class="space-y-4">
          <p class="ds-kicker">FAQ</p>
          <h2 id="faq-title" class="ds-display-l text-[color:var(--ink)]">
            Häufige Fragen
          </h2>
        </div>
        <dl class="space-y-6">
          {post.data.faq.map((item) => (
            <div class="border-t border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pt-6 first:border-t-0 first:pt-0">
              <dt class="ds-display-s text-[color:var(--ink)]">
                {item.question}
              </dt>
              <dd class="mt-3 max-w-[65ch] text-base leading-8 text-[color:var(--ink)]">
                {item.answer}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <RelatedPosts posts={relatedPosts} />

    <footer class="mt-20 border-t border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pt-12">
      <a href="/blog/" class="group inline-flex items-center gap-3 font-mono text-sm uppercase tracking-[0.2em] text-[color:var(--muted)] hover:text-[color:var(--accent-strong)] transition-colors">
        <span class="text-[color:var(--accent-strong)] group-hover:-translate-x-1 transition-transform">←</span>
        Blog
      </a>
    </footer>
    </div>
  </article>
  </main>
</V2Layout>

<script>
  function initReadingProgress() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const bar = document.getElementById('reading-progress');
    const article = document.querySelector('article');
    if (!bar || !article) return;
    if (bar.dataset.initialized === 'true') return;
    bar.dataset.initialized = 'true';

    let ticking = false;
    const update = () => {
      const rect = article.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const total = Math.max(1, rect.height - viewportHeight);
      const scrolled = Math.min(Math.max(-rect.top, 0), total);
      const progress = total > 0 ? scrolled / total : 0;
      bar.style.transform = `scaleX(${Math.max(0, Math.min(1, progress))})`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  document.addEventListener('astro:page-load', initReadingProgress);
</script>

<style is:global>
  .feature-article .blog-feature-header {
    position: relative;
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }

  .feature-article .blog-feature-header::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: clamp(4rem, 10vw, 9rem);
    height: 1px;
    background: var(--accent);
    content: '';
  }

  .feature-article .feature-prose .feature-wide {
    width: min(80rem, calc(100vw - 2rem));
    margin-block: clamp(3rem, 7vw, 6rem);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .feature-article .feature-prose .feature-wide picture,
  .feature-article .feature-prose .feature-wide img {
    display: block;
    width: 100%;
  }

  .feature-article .feature-prose .feature-wide img {
    height: auto;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    filter: saturate(0.88) contrast(1.04);
  }

  .feature-article .feature-prose .feature-wide figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    margin-top: 0.85rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .feature-article .feature-prose .feature-wide figcaption::before {
    color: var(--accent-strong);
    content: 'Abb.';
  }

  .feature-article .feature-prose .feature-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(68rem, calc(100vw - 2rem));
    margin: clamp(3rem, 6vw, 5rem) 0 clamp(3rem, 6vw, 5rem) 50%;
    border-block: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    transform: translateX(-50%);
  }

  .feature-article .feature-prose .feature-fact {
    padding: 1.5rem;
    border-left: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .feature-article .feature-prose .feature-fact:first-child {
    border-left: 0;
  }

  .feature-article .feature-prose .feature-fact strong,
  .feature-article .feature-prose .feature-fact span {
    display: block;
  }

  .feature-article .feature-prose .feature-fact strong {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 400;
  }

  .feature-article .feature-prose .feature-fact span {
    margin-top: 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .feature-article .blog-feature-header h1 {
      font-size: var(--text-display-l);
      line-height: 1.08;
      letter-spacing: -0.02em;
      overflow-wrap: normal;
      hyphens: none;
    }

    .feature-article .feature-prose .feature-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-article .feature-prose .feature-fact:nth-child(3) {
      border-left: 0;
    }

    .feature-article .feature-prose .feature-wide figcaption {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

<script>
  // Copy-Button für Codeblöcke (Issue #215). Nur auf Blog-Artikelseiten
  // eingebunden (nicht global), damit die Mobile-TBT-Bilanz (#200) nicht
  // durch ungenutztes JS auf anderen Seiten belastet wird. Initialisiert auf
  // astro:page-load statt DOMContentLoaded, weil ViewTransitions aktiv sind;
  // pro Codeblock verhindert data-copy-ready doppelte Buttons bei erneutem
  // Feuern des Events (z. B. Browser-Zurück innerhalb der SPA-Navigation).
  function initCodeCopyButtons() {
    const codeBlocks = document.querySelectorAll<HTMLElement>('.v2-prose pre > code');

    codeBlocks.forEach((code) => {
      const pre = code.parentElement;
      if (!pre || pre.dataset.copyReady === 'true') return;
      pre.dataset.copyReady = 'true';

      // Wrapper trägt position:relative — Button in einem scrollenden pre
      // würde sonst horizontal mit dem Code mitwandern
      const wrapper = document.createElement('div');
      wrapper.className = 'v2-code-block';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'v2-copy-btn';
      button.setAttribute('aria-label', 'Code kopieren');

      const label = document.createElement('span');
      label.setAttribute('aria-live', 'polite');
      label.textContent = 'Kopieren';
      button.appendChild(label);

      // number statt ReturnType<typeof setTimeout>: window.setTimeout liefert
      // number, ReturnType löst hier zu NodeJS.Timeout auf (astro check ts2322)
      let resetTimer: number | undefined;

      const resetButton = () => {
        button.classList.remove('is-copied', 'is-error');
        button.setAttribute('aria-label', 'Code kopieren');
        label.textContent = 'Kopieren';
      };

      button.addEventListener('click', async () => {
        window.clearTimeout(resetTimer);

        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.classList.remove('is-error');
          button.classList.add('is-copied');
          button.setAttribute('aria-label', 'Code kopiert');
          label.textContent = 'Kopiert';
        } catch {
          button.classList.remove('is-copied');
          button.classList.add('is-error');
          label.textContent = 'Fehler';
        }

        resetTimer = window.setTimeout(resetButton, 2000);
      });

      wrapper.appendChild(button);
    });
  }

  document.addEventListener('astro:page-load', initCodeCopyButtons);
</script>
