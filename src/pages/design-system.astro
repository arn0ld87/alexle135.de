---
/**
 * V2 Design System Reference
 * Dokumentation des editorial-technischen V2-Designsystems
 */
import V2Layout from '../layouts/V2Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import Showcase from '../components/ds/Showcase';
---

<V2Layout
  title="Design System"
  description="Referenz des editorial-technischen V2-Designsystems von alexle135.de: Farben, Typografie, Komponenten und Patterns."
  noindex={true}
>
  <main class="v2-shell py-20 md:py-28">
    <PageIntro
      kicker="System Reference"
      title="V2 Design System"
      lead="Referenz aller Designentscheidungen, Tokens, Typografie und Komponenten des editorial-technischen Systems."
      aside="Dieses System lebt von Spannung zwischen offenem Raum und präzisen Rahmen, nicht von 40 Karten auf schwarzem Hintergrund."
    />

    <!-- Farben -->
    <section class="mt-20">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">Farben</h2>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Mono-Palette -->
        <div class="v2-panel rounded-sm p-6">
          <h3 class="v2-kicker mb-6">Mono-Palette</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-mono-50)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Mono 50</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#f6f2eb</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-mono-100)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Mono 100</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#e6e0d7</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-mono-200)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Mono 200</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#ccc4ba</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-mono-300)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Mono 300</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#ada398</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-mono-400)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Mono 400</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#8b8177</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-mono-950)]  border border-[color:color-mix(in_srgb,var(--color-mono-50)_12%,transparent)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Mono 950 (Canvas)</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#0d0c0c</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Akzent -->
        <div class="v2-panel rounded-sm p-6">
          <h3 class="v2-kicker mb-6">Akzent & Rollen</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-neon-orange)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Neon Orange</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#ff6a00</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm bg-[color:var(--color-neon-orange-ink)]"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Orange Ink</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">#2a1100</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-10 w-10 rounded-sm v2-panel"></div>
              <div>
                <span class="text-sm text-[color:var(--color-mono-50)]">Surface faint (v2-panel)</span>
                <span class="font-mono text-xs text-[color:var(--color-mono-400)] ml-2">6% mono-50</span>
              </div>
            </div>
          </div>

          <div class="mt-8 border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] pt-6">
            <h4 class="v2-kicker mb-3">Regel</h4>
            <p class="text-sm leading-7 text-[color:var(--color-mono-300)]">80-85% der Fläche bleibt monochrom. Orange markiert Handlung, Spannung oder Systemzustand. Keine zweite dominante Brandfarbe.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Typografie -->
    <section class="mt-20">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">Typografie</h2>

      <div class="v2-panel rounded-sm p-6 md:p-8 space-y-8">
        <div>
          <p class="v2-kicker mb-4">Editorial (Serif)</p>
          <div class="space-y-3">
            <p class="font-editorial text-[clamp(3rem,7vw,5.5rem)] leading-[0.9] tracking-[-0.06em] text-[color:var(--color-mono-50)]">Hero Display</p>
            <p class="font-editorial text-[clamp(2rem,4vw,3.5rem)] leading-[0.92] tracking-[-0.04em] text-[color:var(--color-mono-50)]">Page Heading</p>
            <p class="font-editorial text-[clamp(1.5rem,3vw,2.4rem)] leading-[1.1] tracking-[-0.03em] text-[color:var(--color-mono-50)]">Section Heading</p>
            <p class="font-editorial text-xl text-[color:var(--color-mono-50)]">Card Title</p>
          </div>
        </div>

        <div class="v2-rule"></div>

        <div>
          <p class="v2-kicker mb-4">UI (Sans)</p>
          <div class="space-y-2">
            <p class="font-ui text-lg leading-8 text-[color:var(--color-mono-200)]">Lead-Text - Einleitende Sätze und Zusammenfassungen</p>
            <p class="font-ui text-base leading-7 text-[color:var(--color-mono-300)]">Body-Text - Normaler Fliesstext und Beschreibungen</p>
            <p class="font-ui text-sm leading-7 text-[color:var(--color-mono-300)]">Small Text - Sekundäre Informationen</p>
          </div>
        </div>

        <div class="v2-rule"></div>

        <div>
          <p class="v2-kicker mb-4">System (Mono)</p>
          <div class="space-y-2">
            <p class="v2-kicker">Kicker / Label / Meta</p>
            <p class="font-mono text-xs tabular-nums text-[color:var(--color-mono-400)]">01 / Nummerierung / Datum</p>
            <p class="font-mono text-xs text-[color:var(--color-neon-orange)]">Code-Inline: docker compose up -d</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Utilities -->
    <section class="mt-20">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">Utilities</h2>

      <div class="space-y-4">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <div class="v2-panel rounded-sm p-5">
            <p class="v2-kicker mb-3">v2-shell</p>
            <p class="text-sm text-[color:var(--color-mono-300)]">Hauptcontainer. max-w-7xl, responsive Padding.</p>
            <code class="mt-2 inline-block font-mono text-xs text-[color:var(--color-neon-orange)]">.v2-shell</code>
          </div>

          <div class="v2-panel rounded-sm p-5">
            <p class="v2-kicker mb-3">v2-kicker</p>
            <p class="text-sm text-[color:var(--color-mono-300)]">Uppercase Label. UI-Font, hoher Letter-Spacing.</p>
            <code class="mt-2 inline-block font-mono text-xs text-[color:var(--color-neon-orange)]">.v2-kicker</code>
          </div>

          <div class="v2-panel rounded-sm p-5">
            <p class="v2-kicker mb-3">v2-panel</p>
            <p class="text-sm text-[color:var(--color-mono-300)]">Surface mit Border und Blur. Ersetzt GlassCard.</p>
            <code class="mt-2 inline-block font-mono text-xs text-[color:var(--color-neon-orange)]">.v2-panel</code>
          </div>

          <div class="v2-panel rounded-sm p-5">
            <div class="v2-rule mb-3"></div>
            <p class="v2-kicker mb-3">v2-rule</p>
            <p class="text-sm text-[color:var(--color-mono-300)]">Gradient-Divider. Ersetzt hr und border-Hacks.</p>
            <code class="mt-2 inline-block font-mono text-xs text-[color:var(--color-neon-orange)]">.v2-rule</code>
          </div>

          <div class="v2-panel rounded-sm p-5">
            <div class="flex items-center gap-2 mb-3">
              <span class="v2-accent-dot"></span>
              <p class="v2-kicker">v2-accent-dot</p>
            </div>
            <p class="text-sm text-[color:var(--color-mono-300)]">Orange Markierungspunkt mit Glow.</p>
            <code class="mt-2 inline-block font-mono text-xs text-[color:var(--color-neon-orange)]">.v2-accent-dot</code>
          </div>

          <div class="v2-panel rounded-sm p-5">
            <p class="v2-kicker mb-3">v2-prose</p>
            <p class="text-sm text-[color:var(--color-mono-300)]">Prose-Styling für Markdown-Content.</p>
            <code class="mt-2 inline-block font-mono text-xs text-[color:var(--color-neon-orange)]">.v2-prose</code>
          </div>
        </div>
      </div>
    </section>

    <!-- Komponenten -->
    <section class="mt-20">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">Komponenten</h2>

      <div class="space-y-0 divide-y divide-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)]">
        <div class="grid gap-4 py-8 md:grid-cols-[3rem_1fr_minmax(10rem,0.4fr)]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">01</span>
          <div>
            <h3 class="font-editorial text-xl text-[color:var(--color-mono-50)] mb-1">PageIntro</h3>
            <p class="text-sm text-[color:var(--color-mono-300)]">Seiten-Header mit Kicker, Serif-Headline, Lead und optionaler Aside-Spalte.</p>
          </div>
          <span class="v2-kicker md:text-right">components/site/</span>
        </div>

        <div class="grid gap-4 py-8 md:grid-cols-[3rem_1fr_minmax(10rem,0.4fr)]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">02</span>
          <div>
            <h3 class="font-editorial text-xl text-[color:var(--color-mono-50)] mb-1">CTASection</h3>
            <p class="text-sm text-[color:var(--color-mono-300)]">Abschluss-CTA mit Kicker, Serif-Headline, Body, Primary + Secondary Action.</p>
          </div>
          <span class="v2-kicker md:text-right">components/site/</span>
        </div>

        <div class="grid gap-4 py-8 md:grid-cols-[3rem_1fr_minmax(10rem,0.4fr)]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">03</span>
          <div>
            <h3 class="font-editorial text-xl text-[color:var(--color-mono-50)] mb-1">ServiceEntry</h3>
            <p class="text-sm text-[color:var(--color-mono-300)]">Nummerierter Leistungsblock mit Eyebrow, Titel und Wann/Was/Ergebnis-Struktur.</p>
          </div>
          <span class="v2-kicker md:text-right">components/site/</span>
        </div>

        <div class="grid gap-4 py-8 md:grid-cols-[3rem_1fr_minmax(10rem,0.4fr)]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">04</span>
          <div>
            <h3 class="font-editorial text-xl text-[color:var(--color-mono-50)] mb-1">ProjectEntry</h3>
            <p class="text-sm text-[color:var(--color-mono-300)]">Projekt-Modul mit Visual, Meta-Rail, Stack und View-Link.</p>
          </div>
          <span class="v2-kicker md:text-right">components/site/</span>
        </div>

        <div class="grid gap-4 py-8 md:grid-cols-[3rem_1fr_minmax(10rem,0.4fr)]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">05</span>
          <div>
            <h3 class="font-editorial text-xl text-[color:var(--color-mono-50)] mb-1">BlogEntry</h3>
            <p class="text-sm text-[color:var(--color-mono-300)]">Blog-Listeneintrag mit Datum, Titel, Summary und Meta.</p>
          </div>
          <span class="v2-kicker md:text-right">components/site/</span>
        </div>

        <div class="grid gap-4 py-8 md:grid-cols-[3rem_1fr_minmax(10rem,0.4fr)]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">06</span>
          <div>
            <h3 class="font-editorial text-xl text-[color:var(--color-mono-50)] mb-1">ProofStrip</h3>
            <p class="text-sm text-[color:var(--color-mono-300)]">Kompakte Faktenreihe direkt unter dem Hero.</p>
          </div>
          <span class="v2-kicker md:text-right">components/site/</span>
        </div>
      </div>
    </section>

    <!-- CTA-System -->
    <section class="mt-20">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">CTA-System</h2>

      <div class="v2-panel rounded-sm p-6 md:p-8 space-y-8">
        <div>
          <p class="v2-kicker mb-4">Primary CTA</p>
          <a href="#" class="v2-cta">Kontakt aufnehmen</a>
          <p class="mt-3 text-xs text-[color:var(--color-mono-400)]">Orange Fläche, dunkle Typo, uppercase, tracking, eckig. Hover invertiert zu Kontur statt Glow. Einsatz: Hero, Abschluss, priorisierte Conversion.</p>
        </div>

        <div class="v2-rule"></div>

        <div>
          <p class="v2-kicker mb-4">Secondary CTA</p>
          <a href="#" class="v2-cta-ghost">Projekte ansehen</a>
          <p class="mt-3 text-xs text-[color:var(--color-mono-400)]">Outline-Link, keine Konkurrenz zum Primary. Einsatz: Listenenden, Seitenübergänge.</p>
        </div>

        <div class="v2-rule"></div>

        <div>
          <p class="v2-kicker mb-4">Inline Action</p>
          <a href="#" class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.2em] text-[color:var(--color-neon-orange)] hover:underline">Öffnen <span aria-hidden="true">&rarr;</span></a>
          <p class="mt-3 text-xs text-[color:var(--color-mono-400)]">Textlink mit Arrow. Einsatz: Listeneinträge, Karten.</p>
        </div>
      </div>
    </section>

    <!-- Designprinzipien -->
    <section class="mt-20 mb-8">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">Prinzipien</h2>

      <div class="space-y-0 divide-y divide-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)]">
        <div class="grid gap-4 py-6 md:grid-cols-[3rem_1fr]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">01</span>
          <p class="text-sm leading-7 text-[color:var(--color-mono-200)]">Weniger Flächen, mehr Richtung. Inhalt bleibt wichtiger als Container.</p>
        </div>
        <div class="grid gap-4 py-6 md:grid-cols-[3rem_1fr]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">02</span>
          <p class="text-sm leading-7 text-[color:var(--color-mono-200)]">Typografie trägt die Hierarchie. Headline entscheidet die Seite.</p>
        </div>
        <div class="grid gap-4 py-6 md:grid-cols-[3rem_1fr]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">03</span>
          <p class="text-sm leading-7 text-[color:var(--color-mono-200)]">Der Akzent ist knapp und dadurch wertvoll. Orange nur für Priorität.</p>
        </div>
        <div class="grid gap-4 py-6 md:grid-cols-[3rem_1fr]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">04</span>
          <p class="text-sm leading-7 text-[color:var(--color-mono-200)]">Technical tone without cosplay. Keine Fake-CLI ohne Funktion.</p>
        </div>
        <div class="grid gap-4 py-6 md:grid-cols-[3rem_1fr]">
          <span class="font-mono text-sm text-[color:var(--color-mono-400)]">05</span>
          <p class="text-sm leading-7 text-[color:var(--color-mono-200)]">Pages are systems, not posters. Jede Seite folgt derselben Grammatik.</p>
        </div>
      </div>
    </section>

    <!-- Warm Noir Komponenten-Showcase -->
    <section class="warm-noir mt-20 mb-8">
      <h2 class="font-editorial text-[clamp(2rem,4vw,3rem)] leading-[0.95] tracking-[-0.04em] text-[color:var(--color-mono-50)] mb-10">Warm Noir — Komponenten</h2>
      <Showcase client:visible />
    </section>
  </main>
</V2Layout>
