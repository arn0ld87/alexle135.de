---
import V2Layout from '../layouts/V2Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
---

<V2Layout
  title="System Status"
  description="Aktueller Status der Website und Services von Alexander Schneider."
  noindex={true}
>
  <main class="v2-shell py-20 md:py-28">
    <PageIntro
      kicker="Status"
      title="System Status"
      lead="Transparenz für Verfügbarkeit und Betrieb. Bei Störungen antworte ich schnell über die Kontaktseite."
    />

    <section class="mt-16 grid gap-6 md:grid-cols-3">
      <article class="ds-card">
        <div class="mb-4 inline-flex items-center gap-2 border border-[color:var(--line)] px-3 py-1">
          <span class="h-2 w-2 shrink-0 bg-[color:var(--accent)]"></span>
          <span class="ds-meta">Operational</span>
        </div>
        <h2 class="ds-display-s text-[color:var(--ink)] mb-2">Website</h2>
        <p class="text-sm text-[color:var(--muted)]">Frontend und Routing laufen stabil.</p>
      </article>

      <article class="ds-card">
        <div class="mb-4 inline-flex items-center gap-2 border border-[color:var(--line)] px-3 py-1">
          <span class="h-2 w-2 shrink-0 bg-[color:var(--accent)]"></span>
          <span class="ds-meta">Operational</span>
        </div>
        <h2 class="ds-display-s text-[color:var(--ink)] mb-2">API/Services</h2>
        <p class="text-sm text-[color:var(--muted)]">Suche und Projekt-APIs sind erreichbar.</p>
      </article>

      <article class="ds-card">
        <div class="mb-4 inline-flex items-center gap-2 border border-[color:var(--line)] px-3 py-1">
          <span class="h-2 w-2 shrink-0 bg-[color:var(--muted)]"></span>
          <span class="ds-meta">Monitoring</span>
        </div>
        <h2 class="ds-display-s text-[color:var(--ink)] mb-2">Externe Checks</h2>
        <p class="text-sm text-[color:var(--muted)]">Detail-Monitoring wird aktuell erweitert.</p>
      </article>
    </section>
  </main>
</V2Layout>
