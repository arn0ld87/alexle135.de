---
import { Picture } from 'astro:assets';
import V2Layout from '../layouts/V2Layout.astro';
import CTASection from '../components/site/CTASection.astro';
import portrait from '../assets/portrait/alex-portrait.webp';
import agoraFeed from '../assets/projects/agora-simulation-feed.webp';

// Die Seite liest weder Anfragedaten noch eine Collection. Vorab gebaut entstehen die
// Porträt-Varianten im Build (D-25) und nicht je neuem Besucher zur Laufzeit.
export const prerender = true;

const focusAreas = [
  'Linux-Administration und Container-Betrieb, meistens auf Debian/Ubuntu',
  'Traefik, Supabase und CI/CD mit GitHub Actions',
  'Lokale KI: Ollama, Open WebUI, eigene Agent-Systeme',
  'Runbooks und Doku, damit ein Setup übergebbar bleibt',
] as const;

const homelabItems = [
  'Contabo-VPS mit rund 48 Docker-Containern hinter Traefik: Portfolio, Self-Hosted-Services, Supabase, eigene Tools',
  'Tailscale-Tailnet, damit nichts unnötig im offenen Netz hängt',
  'AdGuard Home als DNS-Filter für Werbung und Tracker im Heimnetz',
  'CachyOS als Daily Driver, MacBook Air M3 für unterwegs, ein iMac 2017 mit OCLP für alles dazwischen',
] as const;

const principles = [
  {
    label: 'Robust schlägt beeindruckend',
    text: 'Ein langweilig laufendes Setup ist mehr wert als eine Architektur, die auf Folien gut aussieht und sonst nirgends.',
  },
  {
    label: 'Erst Problem, dann Tool',
    text: 'Die meisten Projekte entstehen, weil ich selbst ein Problem hatte. Nicht, weil sie gut fürs Portfolio aussehen.',
  },
  {
    label: 'Doku gehört dazu',
    text: 'Wenn ich das Setup in drei Monaten selbst nicht mehr verstehe, ist es nicht fertig. Die Doku kommt nicht immer zuerst, aber sie kommt.',
  },
] as const;

const kiProjekte = [
  {
    name: 'Hermes',
    rolle: 'Self-hosted Agent-Framework',
    text: 'Aktueller Versuch, ein Agent-Framework komplett auf eigener Infrastruktur laufen zu lassen. Kein OpenAI-Key im Hintergrund, keine externen Logs, keine Telemetrie. Gedacht für Aufgaben, bei denen mir Datenabfluss sauer aufstoßen würde. Ersetzt ein früheres Projekt, das ich inzwischen eingestellt habe.',
    status: 'Aktiv in Entwicklung',
    image: null,
    imageAlt: null,
    caption: null,
    href: null,
  },
  {
    name: 'Agora',
    rolle: 'Evidenzorientierte Multi-Agenten-Analyse',
    text: 'Aus Dokumenten und Webseiten entsteht ein Wissensgraph. Daraus leitet Agora prüfbare Stakeholder-Personas ab, lässt sie in einer kontrollierten Simulation interagieren und trennt im Report belegte Aussagen von Hypothesen und Datenlücken. Das System lässt sich lokal oder kontrolliert hybrid betreiben. Es erzeugt Szenarien, keine Vorhersagen. Agora ist ein Fork von MiroFish-Offline (nikmcfly), das auf MiroFish aufbaut; seit dem 21. April 2026 führe ich es eigenständig weiter.',
    status: '0.9.x Stability Beta · AGPL-3.0',
    image: agoraFeed,
    imageAlt: 'Agora-Oberfläche: Feed einer abgeschlossenen Simulation zum erfundenen Fall Lindenhafen, Beiträge mit dem Marker SIM für synthetische Äußerung',
    caption: 'Simulationsfeed im erfundenen Fall Lindenhafen',
    href: '/blog/agora-mirofish-fork-local-first/',
  },
] as const;

const searchFields = [
  'Praktikumsplatz oder Junior-Stelle in Systemintegration oder DevOps',
  'Teams, in denen lokale KI und Self-Hosting kein Nischenthema mehr sind',
  'Kleinere Projektanfragen mit konkretem Problem und sauberer Übergabe',
] as const;
---

<V2Layout
  title="Über mich – Alexander Schneider, FISI Leipzig"
  description="Alexander Schneider aus Leipzig: Mein Weg zum Fachinformatiker Systemintegration, mein Homelab und praktische Projekte mit Linux, Docker und KI."
  schema={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": "https://alex-schneider.dev/ueber-mich/#page",
    "url": "https://alex-schneider.dev/ueber-mich/",
    "name": "Über mich – Alexander Schneider",
    "description": "Alexander Schneider aus Leipzig, angehender Fachinformatiker Systemintegration. Werdegang, Homelab und KI-Projekte (Hermes, Agora).",
    "inLanguage": "de-DE",
    "mainEntity": { "@id": "https://alex-schneider.dev/#person" }
  }}
>
  <main class="v2-shell py-20 md:py-28 lg:py-36">
    <section class="grid gap-16 lg:grid-cols-[minmax(18rem,0.85fr)_minmax(0,2fr)] lg:items-start">
      <aside class="space-y-8">
        <figure class="border border-[color:var(--line)] p-2">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 720, 1080]}
            sizes="(min-width: 1024px) 30vw, 100vw"
            alt="Alexander Schneider – Portrait"
            class="aspect-[2/3] w-full object-cover contrast-110"
            pictureAttributes={{ class: 'block' }}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <div class="space-y-3 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[color:var(--muted)]">
          <div class="flex justify-between border-b border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pb-2">
            <span>Status</span>
            <span class="text-[color:var(--accent-strong)]">In Ausbildung</span>
          </div>
          <div class="flex justify-between border-b border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pb-2">
            <span>Fokus</span>
            <span class="text-[color:var(--ink)]">Systemintegration</span>
          </div>
          <div class="flex justify-between border-b border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pb-2">
            <span>Standort</span>
            <span class="text-[color:var(--ink)]">Leipzig, DE</span>
          </div>
          <div class="flex justify-between border-b border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pb-2">
            <span>Interesse</span>
            <span class="text-[color:var(--ink)]">Praktikum / Projekte</span>
          </div>
        </div>
      </aside>

      <div class="space-y-12">
        <header class="ds-pagehead space-y-6 mb-12">
          <p class="ds-kicker">Über mich</p>
          <h1 class="max-w-5xl ds-display-xl text-[color:var(--ink)]">
            Ich komme nicht aus der klassischen IT-Laufbahn. Das zwingt mich, Sachen wirklich zu verstehen.
          </h1>
          <p class="max-w-[60ch] text-xl leading-relaxed text-[color:var(--ink)]">
            Alexander Schneider, Leipzig. Aktuell mitten in der Umschulung zum Fachinformatiker Systemintegration. Nebenbei läuft ein Homelab, das eigentlich nie für Zuschauer gedacht war, und zwei, drei KI-Projekte, die mir selbst den Alltag interessanter machen.
          </p>
        </header>

        <section class="space-y-6 border-b border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pb-12">
          <p class="ds-kicker">Werdegang</p>
          <h2 class="max-w-4xl ds-display-l text-[color:var(--ink)]">
            Ein paar Umwege, bevor es hier gelandet ist.
          </h2>
          <p class="max-w-[65ch] text-base leading-8 text-[color:var(--ink)]">
            Ich bin nicht direkt von der Schule in die IT gestolpert. Erst Bundeswehr, dann ein paar Jahre bei der Post, später Handel und ein Stück Selbstständigkeit. Dass ich am Ende hier gelandet bin, war kein Masterplan, sondern das Ergebnis aus zu vielen Servern im Regal, kaputten Setups im Keller und dem Moment, an dem ich gemerkt habe: Das hier interessiert mich wirklich.
          </p>
          <p class="max-w-[65ch] text-sm leading-7 text-[color:var(--muted)]">
            Seit 2025 läuft die Umschulung zum Fachinformatiker Systemintegration am BFW Leipzig. Abschluss ist für Juni 2027 geplant. Passende Übungen und Werkzeuge sammle ich im <a href="/fisi/" class="text-[color:var(--accent-strong)] underline underline-offset-4">FISI-Lernpfad mit Tutorials und Tools</a>.
          </p>
        </section>

        <section class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.75fr)] lg:items-start">
          <div class="space-y-5">
            <p class="ds-kicker">Warum IT</p>
            <h2 class="ds-display-l text-[color:var(--ink)]">
              Mich interessiert nicht die Folie, sondern das System dahinter.
            </h2>
            <p class="text-base leading-8 text-[color:var(--ink)]">
              Mich treibt die Frage, warum ein System stabil läuft und wo genau es auseinanderfällt. Ich will verstehen, wie sich Infrastruktur so bauen lässt, dass sie nicht jede Woche Aufmerksamkeit braucht. Was als Fummelei mit ein paar Servern und einem alten Switch im Keller angefangen hat, ist heute mein Berufsweg.
            </p>
          </div>
          <ul class="space-y-3 border-l border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pl-4 text-sm leading-7 text-[color:var(--ink)] lg:pl-6">
            {focusAreas.map((item) => (
              <li class="border-b border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pb-3">{item}</li>
            ))}
          </ul>
        </section>

        <section class="grid gap-8 border-y border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] py-10 md:py-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.75fr)] lg:items-start">
          <div class="space-y-5">
            <p class="ds-kicker">Homelab</p>
            <h2 class="ds-display-l text-[color:var(--ink)]">
              Werkstatt, kein Showroom.
            </h2>
            <p class="text-base leading-8 text-[color:var(--ink)]">
              Im Homelab teste ich, was auf dem VPS und später im Job stabil laufen soll. Hier darf auch mal was krachen, weil es genau dafür da ist.
            </p>
          </div>
          <ul class="space-y-3 border-l border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pl-4 text-sm leading-7 text-[color:var(--ink)] lg:pl-6">
            {homelabItems.map((item) => (
              <li class="border-b border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pb-3">{item}</li>
            ))}
          </ul>
        </section>

        <section class="space-y-8 pb-10 md:pb-12">
          <div class="space-y-5">
            <p class="ds-kicker">Wie ich arbeite</p>
            <h2 class="ds-display-l text-[color:var(--ink)]">
              Drei Sachen, die bei mir ziemlich konstant sind.
            </h2>
          </div>

          <div class="space-y-10">
            {principles.map((principle, index) => (
              <article class="grid gap-6 border-t border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pt-8 first:border-t-0 first:pt-0 lg:grid-cols-[4.5rem_minmax(0,1fr)] lg:gap-10">
                <p class="font-mono text-[0.82rem] leading-6 tracking-[0.18em] text-[color:var(--muted)]">{String(index + 1).padStart(2, '0')}</p>
                <div class="space-y-3">
                  <h3 class="ds-display-m text-[color:var(--ink)]">{principle.label}</h3>
                  <p class="max-w-[65ch] text-base leading-8 text-[color:var(--ink)]">{principle.text}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="space-y-10 border-y border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] py-10 md:py-12">
          <div class="space-y-5">
            <p class="ds-kicker">KI-Projekte</p>
            <h2 class="max-w-4xl ds-display-l text-[color:var(--ink)]">
              Wo ich zurzeit am tiefsten drinstecke.
            </h2>
            <p class="max-w-[65ch] text-base leading-8 text-[color:var(--ink)]">
              Für mich ist KI nicht das Marketing-Thema 2026, sondern Werkzeug. Am meisten lerne ich, wenn ich Systeme selbst baue statt nur APIs anzurufen. Zwei Projekte, an denen das gerade passiert:
            </p>
          </div>

          <div class="space-y-8">
            {kiProjekte.map((p, index) => (
              <article class="grid gap-6 border-t border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pt-8 first:border-t-0 first:pt-0 lg:grid-cols-[4.5rem_minmax(0,1fr)] lg:gap-10">
                <p class="font-mono text-[0.82rem] leading-6 tracking-[0.18em] text-[color:var(--muted)]">{String(index + 1).padStart(2, '0')}</p>
                <div class="space-y-4">
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <h3 class="ds-display-m text-[color:var(--ink)]">{p.name}</h3>
                    <span class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[color:var(--accent-strong)]">{p.rolle}</span>
                  </div>
                  <p class="max-w-[68ch] text-base leading-8 text-[color:var(--ink)]">{p.text}</p>
                  {p.image && (
                    <figure class="mt-6 space-y-3 border border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] p-2">
                      <Picture
                        src={p.image}
                        formats={['avif', 'webp']}
                        fallbackFormat="webp"
                        widths={[640, 960, 1200]}
                        sizes="(min-width: 1024px) 40rem, 100vw"
                        alt={p.imageAlt}
                        class="block h-auto w-full"
                        pictureAttributes={{ class: 'block' }}
                        loading="lazy"
                        decoding="async"
                      />
                      {p.caption && (
                        <figcaption class="px-1 pb-1 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[color:var(--muted)]">
                          {p.caption}
                        </figcaption>
                      )}
                    </figure>
                  )}
                  {p.href && (
                    <a
                      href={p.href}
                      class="inline-flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[color:var(--accent-strong)] transition-colors hover:text-[color:var(--ink)]"
                    >
                      Feature lesen <span aria-hidden="true">→</span>
                    </a>
                  )}
                  <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[color:var(--muted)]">Status: {p.status}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(18rem,0.75fr)] lg:items-start">
          <div class="space-y-5">
            <p class="ds-kicker">Wohin das gehen soll</p>
            <h2 class="ds-display-l text-[color:var(--ink)]">
              Praxis mit echter Reibung, am liebsten in Richtung KI und DevOps.
            </h2>
            <p class="text-base leading-8 text-[color:var(--ink)]">
              Nach dem FISI-Abschluss will ich weiter in Richtung lokaler LLM-Inferenz, GraphRAG und Agent-Orchestrierung, am liebsten auf eigener Hardware. Bis dahin suche ich einen Platz, an dem ich an echter Infrastruktur mitarbeiten kann, ohne dass KI ein Fremdwort bleibt.
            </p>
          </div>
          <ul class="space-y-4 border-l border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pl-4 font-mono text-[0.78rem] uppercase tracking-[0.12em] text-[color:var(--muted)] lg:pl-6">
            {searchFields.map((field) => (
              <li class="border-b border-[color:color-mix(in_srgb,var(--ink)_10%,transparent)] pb-4">
                <span class="text-[color:var(--accent-strong)]">$</span> {field}
              </li>
            ))}
          </ul>
        </section>

        <CTASection
          kicker="Kontakt"
          title="Klingt das nach deinem Team oder deinem Vorhaben? Dann schreib mir."
          body="Praktikum, Junior-Stelle oder Projektanfrage: Eine kurze Nachricht reicht. Ich antworte werktags im Laufe des Tages und lieber konkret als geschniegelt."
          primaryHref="/kontakt/"
          primaryLabel="Kontakt aufnehmen"
          secondaryHref="/projekte/"
          secondaryLabel="Projekte ansehen"
        />
      </div>
    </section>
  </main>
</V2Layout>
