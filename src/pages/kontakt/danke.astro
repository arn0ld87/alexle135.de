---
import V2Layout from '../../layouts/V2Layout.astro';
---

<V2Layout
  title="Vielen Dank"
  description="Deine Nachricht wurde erfolgreich gesendet."
  noindex
>
  <main class="v2-shell py-20 md:py-28 lg:py-36 min-h-[60vh] flex items-center">
    <div class="ds-pagehead max-w-2xl space-y-8">
      <p class="ds-kicker">Nachricht gesendet</p>

      <h1 class="ds-display-xl text-[color:var(--ink)]">
        Vielen Dank.
      </h1>

      <p class="text-xl leading-relaxed text-[color:var(--muted)] max-w-lg">
        Ich habe deine Nachricht erhalten und melde mich so schnell wie möglich.
      </p>

      <div class="pt-6">
        <a
          href="/"
          class="group inline-flex items-center gap-3 font-mono text-sm uppercase tracking-[0.2em] text-[color:var(--muted)] hover:text-[color:var(--accent-strong)] transition-colors"
        >
          <span class="text-[color:var(--accent-strong)] group-hover:-translate-x-1 transition-transform">&larr;</span>
          Startseite
        </a>
      </div>
    </div>
  </main>
</V2Layout>
