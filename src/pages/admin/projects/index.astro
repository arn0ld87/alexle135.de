---
import V2Layout from '../../../layouts/V2Layout.astro';
import { listProjects, type AdminProjectRow } from '../../../lib/db/repositories';

let projects: AdminProjectRow[] = [];
let error: Error | null = null;
try {
  projects = await listProjects();
} catch (err) {
  error = err instanceof Error ? err : new Error('Datenbankfehler.');
}
---

<V2Layout title="Projekte" description="Manage Projects" noindex>
  <main class="mx-auto max-w-5xl px-6 py-16">

    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="v2-kicker mb-2">Admin</p>
        <h1 class="ds-display-m text-[color:var(--ink)]">Projekte</h1>
      </div>
      <a
        href="/admin/projects/new"
        class="inline-flex items-center gap-2 border border-[color:var(--ink)] bg-[color:var(--ink)] px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--paper)] transition-all hover:bg-[color:var(--accent-strong)]"
      >
        Neues Projekt
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </a>
    </div>

    <div class="v2-rule my-8"></div>

    <!-- Projects List -->
    <div id="projects-container" class="space-y-3">
      {error ? (
        <div class="v2-panel p-6 text-center text-[color:var(--danger)] font-[family-name:var(--font-ui)] text-sm">
          Fehler: {error.message}
        </div>
      ) : projects.length === 0 ? (
        <div class="v2-panel p-12 text-center">
          <p class="font-[family-name:var(--font-ui)] text-[color:var(--muted)]">Noch keine Projekte.</p>
        </div>
      ) : (
        projects.map((project) => (
          <div class="v2-panel group flex items-center justify-between p-4 transition-all hover:border-[color:var(--accent)]">
            <div>
              <h3 class="ds-display-s text-[color:var(--ink)]">{project.title}</h3>
              <div class="mt-1 flex items-center gap-3">
                <span class="px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.18em] border border-[color:var(--accent)]/20 bg-[color:var(--accent)]/10 text-[color:var(--accent-strong)]">
                  {project.status}
                </span>
                <span class="font-mono text-[10px] text-[color:var(--muted)]">{project.slug}</span>
                {project.featured && (
                  <span class="px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.18em] border border-[color:var(--accent)]/20 bg-[color:var(--accent)]/10 text-[color:var(--accent-strong)]">
                    Featured
                  </span>
                )}
              </div>
            </div>
            <div class="flex items-center gap-2 opacity-0 transition-opacity group-hover:opacity-100">
              <a
                href={`/admin/projects/${project.id}`}
                class="px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--accent-strong)] transition-colors hover:text-[color:var(--ink)]"
              >
                Edit
              </a>
              <button
                data-id={project.id}
                class="delete-btn px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--danger)] transition-colors hover:text-[color:var(--ink)]"
              >
                Delete
              </button>
            </div>
          </div>
        ))
      )}
    </div>

    <!-- Back link -->
    <div class="mt-8">
      <a href="/admin/dashboard" class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--muted)] transition-colors hover:text-[color:var(--accent-strong)]">
        &larr; Dashboard
      </a>
    </div>
  </main>
</V2Layout>

<script>
  import { adminFetch } from '../../../lib/adminClient';

  function initProjectsList() {
    const buttons = document.querySelectorAll('.delete-btn');
    buttons.forEach((btn) => {
      if ((btn as HTMLElement).dataset.initialized === 'true') return;
      (btn as HTMLElement).dataset.initialized = 'true';

      btn.addEventListener('click', async (e) => {
        if (!confirm('Wirklich löschen?')) return;

        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        if (!id) return;

        const result = await adminFetch(`/api/admin/projects?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
        });

        if (!result.ok) {
          alert(result.error ?? 'Löschen fehlgeschlagen.');
          return;
        }
        window.location.reload();
      });
    });
  }

  document.addEventListener('astro:page-load', initProjectsList);
</script>
