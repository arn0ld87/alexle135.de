---
import V2Layout from '../../../layouts/V2Layout.astro';
import {
  listContactMessages,
  type ContactMessageRow,
  type ContactMessageStatus,
} from '../../../lib/db/repositories';

const url = new URL(Astro.request.url);
const statusLabels = {
  open: 'offen',
  answered: 'beantwortet',
  spam: 'Spam',
  follow_up: 'Follow-up',
} as const;
type MessageFilter = ContactMessageStatus | 'all';
const rawFilter = url.searchParams.get('filter');
const filter: MessageFilter =
  rawFilter && rawFilter in statusLabels ? (rawFilter as ContactMessageStatus) : 'all';

let error: Error | null = null;
let items: ContactMessageRow[] = [];
try {
  items = await listContactMessages({
    status: filter === 'all' ? undefined : filter,
  });
} catch (err) {
  error = err instanceof Error ? err : new Error('Datenbankfehler.');
}

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('de-DE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(new Date(iso));
---

<V2Layout title="Kontaktnachrichten" description="Eingang der Kontaktformular-Nachrichten." noindex>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="v2-kicker mb-2">Admin</p>
        <h1 class="ds-display-m text-[color:var(--ink)]">Kontaktnachrichten</h1>
        <p class="mt-1 font-mono text-xs text-[color:var(--muted)]">{items.length} Eintr&auml;ge</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/admin/messages/"
          class={`border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] transition-all ${filter === 'all' ? 'border-[color:var(--accent)] text-[color:var(--accent-strong)]' : 'border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] text-[color:var(--muted)] hover:text-[color:var(--ink)]'}`}
        >Alle</a>
        <a
          href="/admin/messages/?filter=open"
          class={`border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] transition-all ${filter === 'open' ? 'border-[color:var(--accent)] text-[color:var(--accent-strong)]' : 'border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] text-[color:var(--muted)] hover:text-[color:var(--ink)]'}`}
        >Offen</a>
        <a
          href="/admin/messages/?filter=answered"
          class={`border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] transition-all ${filter === 'answered' ? 'border-[color:var(--accent)] text-[color:var(--accent-strong)]' : 'border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] text-[color:var(--muted)] hover:text-[color:var(--ink)]'}`}
        >Beantwortet</a>
        <a
          href="/admin/messages/?filter=follow_up"
          class={`border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] transition-all ${filter === 'follow_up' ? 'border-[color:var(--accent)] text-[color:var(--accent-strong)]' : 'border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] text-[color:var(--muted)] hover:text-[color:var(--ink)]'}`}
        >Follow-up</a>
        <a
          href="/admin/messages/?filter=spam"
          class={`border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] transition-all ${filter === 'spam' ? 'border-[color:var(--accent)] text-[color:var(--accent-strong)]' : 'border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] text-[color:var(--muted)] hover:text-[color:var(--ink)]'}`}
        >Spam</a>
      </div>
    </div>

    <div class="v2-rule my-8"></div>

    {error && (
      <div class="v2-panel p-6 text-[color:var(--danger)] font-mono text-sm">Fehler: {error.message}</div>
    )}

    <div id="messages-list" class="space-y-3">
      {items.length === 0 && !error && (
        <div class="v2-panel p-12 text-center font-mono text-sm text-[color:var(--muted)]">
          Keine Nachrichten {filter === 'all' ? 'vorhanden' : statusLabels[filter]}.
        </div>
      )}
      {items.map((m) => (
        <article class="v2-panel p-6 space-y-4" data-id={m.id}>
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div class="space-y-1">
              <h2 class="ds-display-s text-[color:var(--ink)]">
                {m.name}
                <span class="ml-3 inline-block border border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] px-2 py-0.5 align-middle font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--muted)]">
                  {statusLabels[m.status] ?? (m.handled ? 'erledigt' : 'offen')}
                </span>
                {m.handled && m.status === 'answered' && (
                  <span class="ml-3 inline-block border border-[color:var(--line)] px-2 py-0.5 align-middle font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--ink)]">
                    erledigt
                  </span>
                )}
              </h2>
              <p class="font-mono text-xs text-[color:var(--muted)]">
                <a href={`mailto:${m.email}`} class="hover:text-[color:var(--accent-strong)] transition-colors">{m.email}</a>
                &nbsp;&middot;&nbsp;{formatDate(m.created_at)}
              </p>
            </div>
            <div class="flex items-center gap-2">
              {m.status !== 'answered' && (
                <button
                  type="button"
                  data-status="answered"
                  class="status-msg-btn border border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--ink)] transition-all hover:border-[color:var(--accent)] hover:text-[color:var(--accent-strong)]"
                >
                  Beantwortet
                </button>
              )}
              <button
                type="button"
                data-status="follow_up"
                class="status-msg-btn border border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--ink)] transition-all hover:border-[color:var(--accent)] hover:text-[color:var(--accent-strong)]"
              >
                Follow-up
              </button>
              <button
                type="button"
                data-status="spam"
                class="status-msg-btn border border-[color:var(--danger)] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--danger)] transition-all hover:bg-[color:color-mix(in_srgb,var(--danger)_10%,transparent)]"
              >
                Spam
              </button>
              <button
                type="button"
                class="delete-msg-btn border border-[color:var(--danger)] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--danger)] transition-all hover:bg-[color:color-mix(in_srgb,var(--danger)_10%,transparent)]"
              >
                Löschen
              </button>
            </div>
          </header>
          <p class="whitespace-pre-wrap text-sm leading-7 text-[color:var(--ink)]">{m.message}</p>
          {m.user_agent && (
            <p class="font-mono text-[10px] text-[color:var(--muted)] break-all">{m.user_agent}</p>
          )}
        </article>
      ))}
    </div>

    <div class="mt-8">
      <a href="/admin/dashboard" class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--muted)] transition-colors hover:text-[color:var(--accent-strong)]">
        &larr; Dashboard
      </a>
    </div>
  </main>
</V2Layout>

<script>
  import { adminFetch } from '../../../lib/adminClient';

  function init() {
    const list = document.getElementById('messages-list');
    if (!list) return;
    if (list.dataset.initialized === 'true') return;
    list.dataset.initialized = 'true';

    list.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const article = target.closest('article[data-id]') as HTMLElement | null;
      if (!article) return;
      const id = article.dataset.id;
      if (!id) return;

      if (target.classList.contains('status-msg-btn')) {
        const status = target.dataset.status;
        if (!status) return;
        const result = await adminFetch('/api/admin/messages', {
          method: 'PATCH',
          json: { id, status },
        });
        if (!result.ok) {
          alert(result.error ?? 'Fehler.');
          return;
        }
        window.location.reload();
      } else if (target.classList.contains('delete-msg-btn')) {
        if (!confirm('Nachricht wirklich löschen?')) return;
        const result = await adminFetch(`/api/admin/messages?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
        });
        if (!result.ok) {
          alert(result.error ?? 'Fehler.');
          return;
        }
        article.remove();
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
