---
import V2Layout from '../../../layouts/V2Layout.astro';
import MarkdownEditor from '../../../components/admin/MarkdownEditor.tsx';
import { getPost } from '../../../lib/db/repositories';

const { id } = Astro.params;

let post = {
  title: '',
  slug: '',
  summary: '',
  content: '',
  published: false,
  tags: [] as string[],
};

if (id && id !== 'new') {
  try {
    const data = await getPost(id);
    if (data) {
      post = {
        title: typeof data.title === 'string' ? data.title : '',
        slug: typeof data.slug === 'string' ? data.slug : '',
        summary: typeof data.summary === 'string' ? data.summary : '',
        content: typeof data.content === 'string' ? data.content : '',
        published: data.published === true,
        tags: Array.isArray(data.tags) ? data.tags.filter((tag): tag is string => typeof tag === 'string') : [],
      };
    }
  } catch {
    // ungültige UUID oder DB-Fehler → leere Editor-Form statt 500
  }
}

const pageTitle = id === 'new' ? 'Neuer Beitrag' : 'Beitrag bearbeiten';
---

<V2Layout title={pageTitle} description="Post Editor" noindex>
  <main class="mx-auto max-w-4xl px-6 py-16">
    <form id="post-form" class="space-y-8" method="POST">

      <!-- Header -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="v2-kicker mb-2">Blog</p>
          <h1 class="ds-display-m text-[color:var(--ink)]">{pageTitle}</h1>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            onclick="history.back()"
            class="border border-[color:color-mix(in_srgb,var(--ink)_16%,transparent)] px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--muted)] transition-all hover:border-[color:var(--ink)] hover:text-[color:var(--ink)]"
          >
            Abbrechen
          </button>
          <button
            type="submit"
            class="border border-[color:var(--ink)] bg-[color:var(--ink)] px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--paper)] transition-all hover:bg-[color:var(--accent-strong)]"
          >
            Speichern
          </button>
        </div>
      </div>

      <div class="v2-rule"></div>

      <!-- Form Fields -->
      <div class="v2-panel p-6 sm:p-8 space-y-6">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <label class="v2-kicker mb-2 block">Titel</label>
            <input
              type="text"
              name="title"
              value={post.title}
              required
              class="w-full border border-[color:var(--muted)] bg-[color:var(--paper)] px-4 py-3 text-[color:var(--ink)] placeholder-[color:var(--muted)] focus:outline-none focus-visible:border-[color:var(--ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--accent)] transition-colors font-ui text-sm"
            />
          </div>
          <div>
            <label class="v2-kicker mb-2 block">Slug</label>
            <input
              type="text"
              name="slug"
              value={post.slug}
              required
              class="w-full border border-[color:var(--muted)] bg-[color:var(--paper)] px-4 py-3 text-[color:var(--ink)] placeholder-[color:var(--muted)] focus:outline-none focus-visible:border-[color:var(--ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--accent)] transition-colors font-ui text-sm"
            />
          </div>
        </div>

        <div>
          <label class="v2-kicker mb-2 block">Zusammenfassung</label>
          <textarea
            name="summary"
            rows="3"
            class="w-full border border-[color:var(--muted)] bg-[color:var(--paper)] px-4 py-3 text-[color:var(--ink)] placeholder-[color:var(--muted)] focus:outline-none focus-visible:border-[color:var(--ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--accent)] transition-colors font-ui text-sm"
          >{post.summary}</textarea>
        </div>

        <div>
          <MarkdownEditor client:load initialValue={post.content} />
          <input type="hidden" name="content" id="content-hidden" value={post.content} />
        </div>

        <div class="flex items-center gap-3">
          <input
            type="checkbox"
            id="published"
            name="published"
            checked={post.published}
            class="h-4 w-4 accent-[color:var(--accent)] bg-transparent border-[color:var(--muted)]"
          />
          <label for="published" class="font-[family-name:var(--font-ui)] text-sm text-[color:var(--muted)]">Veröffentlicht</label>
        </div>
      </div>
    </form>
  </main>
</V2Layout>

<script define:vars={{ id }}>
  // Make id available in module scope
  window.__postId = id;
</script>

<script>
  import { adminFetch } from '../../../lib/adminClient';

  function initPostEditor() {
    const form = document.getElementById('post-form') as HTMLFormElement | null;
    if (!form) return;
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const postId = (window as unknown as { __postId: string }).__postId;
      const formData = new FormData(form);
      const payload: Record<string, unknown> = {
        title: String(formData.get('title') ?? ''),
        slug: String(formData.get('slug') ?? ''),
        summary: String(formData.get('summary') ?? ''),
        published: formData.get('published') === 'on',
        tags: [],
      };

      const editorField = document.querySelector<HTMLTextAreaElement>(
        'textarea[name="content"], .markdown-editor textarea'
      );
      const hidden = document.getElementById('content-hidden') as HTMLInputElement | null;
      payload.content = editorField?.value ?? hidden?.value ?? '';

      const isNew = postId === 'new';
      const result = await adminFetch('/api/admin/posts', {
        method: isNew ? 'POST' : 'PUT',
        json: isNew ? payload : { id: postId, ...payload },
      });

      if (!result.ok) {
        alert('Fehler: ' + (result.error ?? 'unbekannt'));
        return;
      }
      window.location.href = '/admin/posts';
    });
  }

  document.addEventListener('astro:page-load', initPostEditor);
</script>
