---
import V2Layout from '../../../layouts/V2Layout.astro';
import { listPosts, type AdminPostRow } from '../../../lib/db/repositories';

let posts: AdminPostRow[] = [];
let error: Error | null = null;
try {
  posts = await listPosts();
} catch (err) {
  error = err instanceof Error ? err : new Error('Datenbankfehler.');
}
---

<V2Layout title="Blog Posts" description="Manage Blog Posts" noindex>
  <main class="mx-auto max-w-5xl px-6 py-16">

    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="v2-kicker mb-2">Admin</p>
        <h1 class="font-[family-name:var(--font-editorial)] text-3xl tracking-tight text-[color:var(--color-mono-50)]">Blog Posts</h1>
      </div>
      <a
        href="/admin/posts/new"
        class="inline-flex items-center gap-2 border border-[color:var(--color-neon-orange)] bg-[color:var(--color-neon-orange)] px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-neon-orange-ink)] transition-all hover:bg-transparent hover:text-[color:var(--color-neon-orange)]"
      >
        Neuer Beitrag
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </a>
    </div>

    <div class="v2-rule my-8"></div>

    <!-- Posts List -->
    <div id="posts-container" class="space-y-3">
      {error ? (
        <div class="v2-panel p-6 text-center text-red-400 font-[family-name:var(--font-ui)] text-sm">
          Fehler: {error.message}
        </div>
      ) : posts.length === 0 ? (
        <div class="v2-panel p-12 text-center">
          <p class="font-[family-name:var(--font-ui)] text-[color:var(--color-mono-500)]">Noch keine Beitraege.</p>
        </div>
      ) : (
        posts.map((post) => (
          <div class="v2-panel group flex items-center justify-between p-4 transition-all hover:border-[color:var(--color-neon-orange)]">
            <div>
              <h3 class="font-[family-name:var(--font-editorial)] text-lg text-[color:var(--color-mono-50)]">{post.title}</h3>
              <div class="mt-1 flex items-center gap-3">
                <span class={`px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.18em] ${post.published ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-yellow-500/10 text-yellow-400 border border-yellow-500/20'}`}>
                  {post.published ? 'Live' : 'Entwurf'}
                </span>
                <span class="font-mono text-[10px] text-[color:var(--color-mono-500)]">
                  {new Date(post.created_at).toLocaleDateString('de-DE')}
                </span>
                <span class="font-mono text-[10px] text-[color:var(--color-mono-600)]">{post.slug}</span>
              </div>
            </div>
            <div class="flex items-center gap-2 opacity-0 transition-opacity group-hover:opacity-100">
              <a
                href={`/admin/posts/${post.id}`}
                class="px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-neon-orange)] transition-colors hover:text-[color:var(--color-mono-50)]"
              >
                Edit
              </a>
              <button
                data-id={post.id}
                class="delete-btn px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-red-400 transition-colors hover:text-red-300"
              >
                Delete
              </button>
            </div>
          </div>
        ))
      )}
    </div>

    <!-- Back link -->
    <div class="mt-8">
      <a href="/admin/dashboard" class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-mono-500)] transition-colors hover:text-[color:var(--color-neon-orange)]">
        &larr; Dashboard
      </a>
    </div>
  </main>
</V2Layout>

<script>
  import { adminFetch } from '../../../lib/adminClient';

  function initPostsList() {
    const buttons = document.querySelectorAll('.delete-btn');
    buttons.forEach((btn) => {
      if ((btn as HTMLElement).dataset.initialized === 'true') return;
      (btn as HTMLElement).dataset.initialized = 'true';

      btn.addEventListener('click', async (e) => {
        if (!confirm('Wirklich löschen?')) return;

        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        if (!id) return;

        const result = await adminFetch(`/api/admin/posts?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
        });

        if (!result.ok) {
          alert(result.error ?? 'Löschen fehlgeschlagen.');
          return;
        }
        window.location.reload();
      });
    });
  }

  document.addEventListener('astro:page-load', initPostsList);
</script>
