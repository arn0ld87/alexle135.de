---
import V2Layout from '../layouts/V2Layout.astro';
---

<V2Layout
  title="404 – Seite nicht gefunden"
  description="Diese Seite existiert nicht oder wurde verschoben."
>
  <main class="v2-shell py-20 md:py-28 lg:py-36 min-h-[70vh] flex items-center">
    <div class="ds-pagehead max-w-3xl space-y-8">
      <p class="ds-kicker">Error / 404</p>

      <h1 class="ds-display-xl text-[color:var(--ink)]">
        Seite nicht gefunden.
      </h1>

      <p class="text-xl leading-relaxed text-[color:var(--muted)] max-w-xl">
        Die gesuchte Seite wurde verschoben, entfernt oder hat nie existiert.
      </p>

      <div class="pt-6 flex items-center gap-8">
        <a
          href="/"
          class="v2-cta"
        >
          Startseite
        </a>
        <a
          href="/projekte/"
          class="font-mono text-sm uppercase tracking-[0.2em] text-[color:var(--muted)] hover:text-[color:var(--accent-strong)] transition-colors"
        >
          Projekte ansehen
        </a>
      </div>
    </div>
  </main>
</V2Layout>
