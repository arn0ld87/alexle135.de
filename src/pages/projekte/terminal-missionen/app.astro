---
import V2Layout from '../../../layouts/V2Layout.astro';
import MissionTerminal from '../../../components/interactive/MissionTerminal.tsx';
---

<V2Layout
  title="Terminal Missionen – Interaktive Linux & DevOps Tutorials"
  canonical="/projekte/terminal-missionen/"
  robots="noindex, follow"
  description="Lerne Linux, Docker und Git spielerisch mit interaktiven Terminal-Simulationen. Geführte Missionen mit Echtzeit-Feedback."
>
  <main class="v2-shell py-20 md:py-28">
    <header class="ds-pagehead ds-linegrid space-y-6 mb-12">
      <p class="ds-kicker">Interactive Learning Platform</p>

      <h1 class="ds-pagehead__title ds-display-xl">
        Terminal Missionen
      </h1>

      <p class="ds-pagehead__lead">
        Lerne Linux, Docker und Git durch praktische Übungen im simulierten Terminal.
      </p>
    </header>

    <div class="mb-20">
      <MissionTerminal client:visible />
    </div>

    <section class="border-t border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pt-16">
      <div class="grid md:grid-cols-3 gap-12">
        <div class="space-y-3">
          <span class="ds-meta">01</span>
          <h3 class="ds-display-s text-[color:var(--ink)]">Learning by Doing</h3>
          <p class="text-sm leading-relaxed text-[color:var(--muted)]">
            Tippe echte Befehle und lerne praktisch — keine Installation nötig.
          </p>
        </div>
        <div class="space-y-3">
          <span class="ds-meta">02</span>
          <h3 class="ds-display-s text-[color:var(--ink)]">Geführte Tutorials</h3>
          <p class="text-sm leading-relaxed text-[color:var(--muted)]">
            Schritt-für-Schritt Anleitungen mit Hints und Echtzeit-Validierung.
          </p>
        </div>
        <div class="space-y-3">
          <span class="ds-meta">03</span>
          <h3 class="ds-display-s text-[color:var(--ink)]">6 Tutorial-Tracks</h3>
          <p class="text-sm leading-relaxed text-[color:var(--muted)]">
            Von Linux-Basics bis Docker Compose — für Beginner bis Advanced.
          </p>
        </div>
      </div>
    </section>

    <footer class="mt-20 border-t border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pt-12">
      <a href="/projekte/terminal-missionen/" class="group inline-flex items-center gap-3 font-mono text-sm uppercase tracking-[0.2em] text-[color:var(--muted)] hover:text-[color:var(--accent-strong)] transition-colors">
        <span class="text-[color:var(--accent-strong)] group-hover:-translate-x-1 transition-transform">&larr;</span>
        Projekt-Übersicht
      </a>
    </footer>
  </main>
</V2Layout>
