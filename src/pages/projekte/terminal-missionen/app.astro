---
import V2Layout from '../../../layouts/V2Layout.astro';
import MissionTerminal from '../../../components/interactive/MissionTerminal.tsx';
---

<V2Layout
  title="Ein Linux-Krimi · Staffel 1 · Fall Kehrwoche"
  canonical="/projekte/terminal-missionen/"
  robots="noindex, follow"
  image="/missions/trailer/titelkarte-8558534e.jpg"
  imageAlt="Ein Linux-Krimi · Staffel 1 · Fall Kehrwoche"
  description="Echtes Linux im Browser: Alex ist im Urlaub, und auf seinem Server räumt jemand auf, der das nicht soll. Löse acht Episoden mit echten Admin-Handgriffen."
>
  <!-- Auf dem Desktop füllt die Seite genau das Fenster unter der Navigation (72px + 1px Linie):
       Das Terminal steht ganz im Bild, ohne dass der Titel unter die Navigation scrollt (#411). -->
  <main class="v2-shell pt-5 pb-4 lg:flex lg:h-[calc(100dvh-73px)] lg:flex-col">
    <header class="mb-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h1 class="ds-display-s text-[color:var(--ink)]">
        Ein Linux-Krimi <span class="text-[color:var(--muted)]">· Staffel 1 · Fall Kehrwoche</span>
      </h1>
      <a
        href="/projekte/terminal-missionen/"
        class="group inline-flex items-center gap-2 font-mono text-xs tracking-[0.2em] text-[color:var(--muted)] uppercase transition-colors hover:text-[color:var(--accent-strong)]"
      >
        <span class="text-[color:var(--accent-strong)] transition-transform group-hover:-translate-x-1"
          >&larr;</span
        >
        Zur Projektseite
      </a>
    </header>
    <MissionTerminal client:visible />
  </main>
</V2Layout>
