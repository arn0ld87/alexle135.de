---
import V2Layout from '../../../../layouts/V2Layout.astro';
import Staffel2Seite from '../../../../components/missions/Staffel2Seite';
import {
  STAFFEL2_PFAD,
  staffel2Episoden,
  staffel2Uebersicht,
  waehleEpisode,
  weiterZurNaechsten,
} from '../../../../data/staffeln/staffel-2';

// ?episode=<nr> wählt eine Episode der Liste, ein unbekannter Wert Episode 0. Ohne Angabe wählt der
// Browser die erste ungelöste Episode (der Server kennt den Stand nicht) und bekommt dafür alle.
const wert = Astro.url.searchParams.get('episode');
const gewaehlt = wert === null ? null : waehleEpisode(wert).ermittlung.nr;
const episoden = staffel2Episoden
  .filter((eintrag) => gewaehlt === null || eintrag.ermittlung.nr === gewaehlt)
  .map((eintrag) => ({ ...eintrag, weiter: weiterZurNaechsten(eintrag.ermittlung) }));
---

<V2Layout
  title="Ein Linux-Krimi · Staffel 2"
  canonical="/projekte/terminal-missionen/app/staffel-2/"
  robots="index, follow"
  description="Staffel 2 des Linux-Krimis: Du prüfst die Server der Rechenwerk Ostwind GmbH mit echtem Linux im Browser, sicherst Belege und beweist deinen Verdacht."
  spielmodus
>
  <!-- Spielmodus (#170): ohne Website-Navigation und Footer füllt die Spielfläche genau das Fenster.
       Gescrollt wird nur innerhalb der Flächen, nie die Seite. -->
  <div
    class="krimi-spiel relative isolate flex min-h-0 flex-1 flex-col overflow-hidden bg-[#0a0d12] text-[color:var(--ink)]"
  >
    <img
      src="/missions/hintergrund/serverraum.webp"
      alt=""
      width="1672"
      height="941"
      decoding="async"
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[rgba(8,11,16,0.8)]">
    </div>
    <Staffel2Seite
      client:only="react"
      episoden={episoden}
      uebersicht={staffel2Uebersicht}
      gewaehlt={gewaehlt}
      startHref={STAFFEL2_PFAD}
    />
  </div>
</V2Layout>

<style is:global>
  /* Dunkle Tokens nur für die Spielfläche von Staffel 2 (#170); Staffel 1 und die Website bleiben. */
  .krimi-spiel {
    --paper: #121922;
    --ink: #ede6da;
    --muted: #b3aa9c;
    --line: rgba(237, 230, 218, 0.16);
    --accent: #e8552f;
    --accent-strong: #f4a58e;
    color-scheme: dark;
  }
  .krimi-spiel :focus-visible {
    outline: 2px solid #e8552f;
    outline-offset: 2px;
  }
</style>
