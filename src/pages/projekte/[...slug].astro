---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import V2Layout from '../../layouts/V2Layout.astro';
import Trailer from '../../components/projects/Trailer.astro';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { slug } = Astro.params;
let project: CollectionEntry<'projects'> | undefined = Astro.props.project;

if (!project && slug) {
  project = await getEntry('projects', slug);
}

if (!project) {
  return Astro.redirect('/404');
}

const { Content } = await render(project);

// Schema.org-Typ nach Inhaltsart: Schema-Default ist SoftwareApplication
// (interaktive Tools/Apps); Vorträge/Case-Studies setzen schemaType im
// Frontmatter (z.B. CreativeWork). applicationCategory/operatingSystem sind
// nur für SoftwareApplication/SoftwareSourceCode gültig und entfallen sonst.
const schemaType = project.data.schemaType;
const isSoftwareType = schemaType === "SoftwareApplication" || schemaType === "SoftwareSourceCode";

const projectSchema = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": project.data.title,
  "description": project.data.summary,
  "author": { "@id": "https://alex-schneider.dev/#person" },
  "image": project.data.ogImage
    ? new URL(project.data.ogImage, Astro.site).toString()
    : project.data.heroImage
      ? new URL(project.data.heroImage.src, Astro.site).toString()
      : undefined,
  "applicationCategory": isSoftwareType ? "DeveloperApplication" : undefined,
  "operatingSystem": isSoftwareType ? "Web" : undefined,
  "keywords": project.data.tags ? project.data.tags.join(", ") : undefined
};

// Breadcrumb wird in V2Layout per buildBreadcrumbSchema() automatisch generiert.
// Keine Duplikation mehr hier, sonst liefert Google zwei BreadcrumbList-Graphen.
const schema = projectSchema;
---

<V2Layout
  title={project.data.title}
  description={project.data.summary}
  image={project.data.ogImage}
  ogSlug={project.data.ogImage ? undefined : project.id}
  ogBasePath="/og/projekte"
  schema={schema}
>
  <main>
  <article class="v2-shell py-20 md:py-28 max-w-5xl mx-auto">
    
    <header class="ds-pagehead space-y-10 mb-20">
      <p class="ds-kicker">Projekt / {project.data.role || 'Development'}</p>

      <h1 class="max-w-4xl ds-display-xl text-[color:var(--ink)]">
        {project.data.title}
      </h1>

      <p class="max-w-[60ch] text-[length:var(--ds-text-body)] leading-[1.55] text-[color:var(--ink)]">
        {project.data.summary}
      </p>

      {project.data.appUrl && (
        <a
          href={project.data.appUrl}
          data-astro-reload
          class="inline-flex items-center gap-3 border border-[color:var(--ink)] bg-[color:var(--ink)] px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--paper)] transition-colors hover:border-[color:var(--accent-strong)] hover:bg-[color:var(--accent-strong)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--accent)]"
        >
          Missionen starten <span aria-hidden="true">→</span>
        </a>
      )}

      {project.data.techStack && project.data.techStack.length > 0 && (
        <div class="flex flex-col gap-3">
          <p class="ds-meta">Tech Stack</p>
          <ul class="flex flex-wrap gap-2">
            {project.data.techStack.map((tech) => (
              <li class="ds-tag">{tech}</li>
            ))}
          </ul>
        </div>
      )}
    </header>

    {project.data.trailer && (
      <Trailer
        src={project.data.trailer.src}
        srcKlein={project.data.trailer.srcKlein}
        poster={project.data.trailer.poster}
        titel={project.data.title}
        textfassung={project.data.trailer.textfassung}
      />
    )}

    {!project.data.trailer && project.data.heroImage && (
      <figure class="mb-20 border border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] p-2">
         <Picture
           src={project.data.heroImage}
           formats={['avif', 'webp']}
           fallbackFormat="webp"
           widths={[640, 960, 1440]}
           sizes="(min-width: 1280px) 1200px, 100vw"
           alt={project.data.heroImageAlt ?? project.data.title}
           class="w-full h-auto aspect-video object-cover grayscale-[10%] contrast-[1.1]"
           pictureAttributes={{ class: 'block' }}
           loading="eager"
           fetchpriority="high"
           decoding="async"
         />
         {project.data.frameLabel && (
           <figcaption class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--muted)] text-right">
             Fig 1.0 — {project.data.frameLabel}
           </figcaption>
         )}
      </figure>
    )}

    <div class="v2-prose max-w-3xl mx-auto">
      <Content />
    </div>

    <footer class="mt-32 max-w-3xl mx-auto border-t border-[color:color-mix(in_srgb,var(--ink)_12%,transparent)] pt-12 flex justify-between items-center">
      <a href="/projekte/" class="group inline-flex items-center gap-3 font-mono text-sm uppercase tracking-[0.2em] text-[color:var(--muted)] hover:text-[color:var(--accent-strong)] transition-colors">
        <span class="text-[color:var(--accent-strong)] group-hover:-translate-x-1 transition-transform">←</span>
        Projekte
      </a>
      
      {project.data.repoUrl && (
        <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs uppercase tracking-[0.2em] text-[color:var(--muted)] hover:text-[color:var(--accent-strong)] transition-colors underline underline-offset-4">
          View Repository ↗
        </a>
      )}
    </footer>
  </article>
  </main>
</V2Layout>
