---
import { getCollection } from 'astro:content';
import V2Layout from '../../layouts/V2Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import ProjectEntry from '../../components/site/ProjectEntry.astro';
import CTASection from '../../components/site/CTASection.astro';

export const prerender = true;

const proofLines: Record<string, string> = {
  'terminal-missionen': 'Produktdenken, Browser-Interaktion und Lern-UX fuer technische Inhalte.',
  'windows-terminal-missionen': 'Didaktik, Simulation und technisches Onboarding fuer Windows-Workflows.',
  'roi-rechner': 'Greifbarer Business-Nutzen statt Tool-Spielerei.',
  'compose-builder': 'Strukturierte Developer-Workflows und sauber gefuehrte Automatisierung.',
  'csharp-trainer': 'Didaktik, Browser-Interaktion und ein Lernprodukt, das direkt benutzbar ist.',
  'ticket-routing': 'KI als Workflow-Baustein statt dekorativer Schicht.',
  'ki-nachrichten-portal': 'Informationsaggregation, Priorisierung und verdauliche technische Aufbereitung.',
  'ihk-radar': 'Recherche, Datenlogik und praxisnahe Unterstuetzung fuer echte Entscheidungen.',
  'm2-schnittstelle': 'Integrationsdenken, Prozessmodellierung und saubere Uebergaenge zwischen Systemen.',
};

const featuredOrder = [
  'terminal-missionen',
  'csharp-trainer',
  'ticket-routing',
  'compose-builder',
  'roi-rechner',
  'windows-terminal-missionen',
  'ki-nachrichten-portal',
  'ihk-radar',
  'm2-schnittstelle',
];

const relatedHubs = [
  {
    href: '/apps/',
    title: 'Tools & Apps',
    body: 'Wenn du direkt in die nutzbaren Browser-Tools springen willst, statt erst die Case-Studies zu lesen.',
  },
  {
    href: '/ki-agenten-lab/',
    title: 'KI-Agenten Lab',
    body: 'Die Seite für Agenten-Use-Cases, Prozesslogik und die Frage, wo KI im Ablauf sinnvoll sitzt.',
  },
  {
    href: '/kompetenzen/',
    title: 'Kompetenzen',
    body: 'Die technische Kurzfassung der Skills hinter den Projekten: Betrieb, Automation, Monitoring und APIs.',
  },
] as const;

const projects = await getCollection('projects');
projects.sort((a, b) => {
  const indexA = featuredOrder.indexOf(a.id);
  const indexB = featuredOrder.indexOf(b.id);
  if (indexA !== -1 || indexB !== -1) {
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;
    return indexA - indexB;
  }
  const dateA = a.data.publishedAt || new Date(0);
  const dateB = b.data.publishedAt || new Date(0);
  return dateB.getTime() - dateA.getTime();
});

const projectsSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projekte',
  url: 'https://alexle135.de/projekte/',
  description:
    'Ausgewählte Projekte zu Lernprodukten, Automatisierung, Infrastruktur und technischer Umsetzung.',
  inLanguage: 'de-DE',
  author: {
    '@type': 'Person',
    name: 'Alexander Schneider',
    url: 'https://alexle135.de/ueber-mich/',
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://alexle135.de/projekte/${project.id}/`,
      item: {
        '@type': 'CreativeWork',
        name: project.data.title,
        url: `https://alexle135.de/projekte/${project.id}/`,
        description: project.data.summary,
        datePublished: project.data.publishedAt?.toISOString(),
        keywords: project.data.tags,
      },
    })),
  },
};
---

<V2Layout
  title="Projekte – DevOps, Automation, Infrastruktur"
  description="Lernprojekte, Automatisierungs-Tools und Infrastruktur-Experimente von Alexander Schneider aus Leipzig. Mit Code, Doku und offenem Einblick in Entscheidungen."
  schema={projectsSchema}
>
  <main class="v2-shell py-20 md:py-28">
    <PageIntro
      kicker="Projekte"
      title="Projekte, an denen man sieht, wie ich arbeite."
      lead="Keine erfundenen Fallstudien, sondern konkrete Tools, Lernprodukte und Automatisierungen, an denen man Umsetzung, Denkweise und technische Schwerpunkte erkennt."
      aside="Die wichtigsten Sachen stehen vorne. Der Rest kommt danach. So liest es sich einfach besser."
    />

    <section class="grid gap-8 border-y border-[color:color-mix(in_srgb,var(--color-mono-50)_12%,transparent)] py-10 md:py-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(18rem,0.75fr)] lg:items-start mt-12 md:mt-16">
      <div class="space-y-5">
        <p class="v2-kicker">Leselogik</p>
        <h2 class="text-balance font-editorial text-[clamp(2.2rem,1.4rem_+_2.4vw,3.4rem)] leading-[0.96] tracking-[-0.04em] text-[color:var(--color-mono-50)]">
          Nicht jedes Projekt ist gleich wichtig. Also steht das Wichtigste zuerst.
        </h2>
      </div>
      <div class="space-y-4 border-l border-[color:color-mix(in_srgb,var(--color-mono-50)_10%,transparent)] pl-4 lg:pl-6 text-sm leading-7 text-[color:var(--color-mono-200)]">
        <p>Die stärksten Einträge stehen vorne: Produkt, Automatisierung und infrastrukturlastige Themen. Kleinere oder speziellere Projekte kommen danach.</p>
        <p class="text-[color:var(--color-mono-300)]">Jeder Eintrag zeigt außerdem kurz, worin der eigentliche Wert liegt. Sonst muss der Besucher sich alles selbst zusammensuchen.</p>
      </div>
    </section>

    <div class="space-y-20 pt-12 md:space-y-28 md:pt-16">
      {projects.map((project, index) => (
        <ProjectEntry
          number={String(index + 1).padStart(2, '0')}
          title={project.data.title}
          href={`/projekte/${project.id}/`}
          summary={project.data.summary}
          proofLine={proofLines[project.id] || 'praktische technische Umsetzung mit klarer Produkt- und Systemlogik.'}
          tags={project.data.tags || []}
          image={project.data.heroImage}
          imageAlt={project.data.heroImageAlt}
          year={project.data.publishedAt ? new Intl.DateTimeFormat('de-DE', { year: 'numeric' }).format(new Date(project.data.publishedAt)) : undefined}
          dateTime={project.data.publishedAt?.toISOString()}
        />
      ))}
    </div>

    <section class="grid gap-6 border-t border-[color:color-mix(in_srgb,var(--color-mono-50)_12%,transparent)] pt-16 md:grid-cols-3 md:pt-20">
      {relatedHubs.map((hub) => (
        <a href={hub.href} class="v2-panel rounded-sm p-6 transition-colors hover:border-[color:color-mix(in_srgb,var(--color-neon-orange)_28%,transparent)]">
          <p class="v2-kicker mb-4">{hub.title}</p>
          <p class="text-sm leading-7 text-[color:var(--color-mono-200)]">{hub.body}</p>
          <span class="mt-5 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[color:var(--color-neon-orange)]">
            Mehr Kontext <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </section>

    <section class="pt-20 md:pt-28">
      <CTASection
        kicker="Naechster Schritt"
        title="Wenn du ein ähnliches Projekt planst oder nach einem Azubi / Junior-Kollegen suchst, freue ich mich über eine Nachricht."
        body="Die Projekte hier zeigen, wie ich arbeite. Ob Ausbildungsstelle, Kooperation oder technischer Austausch – eine kurze Mail reicht für einen ersten Abgleich."
        primaryHref="/kontakt/"
        primaryLabel="In Kontakt kommen"
        secondaryHref="/ueber-mich/"
        secondaryLabel="Über mich"
      />
    </section>
  </main>
</V2Layout>
