# Staffel 1 (#400): azubi darf genau das Konto kehrwoche sperren, entsperren und seinen Status
# ansehen. Feste Argumente, damit sudo kein Weg zu root ist (kein passwd root, kein usermod -u 0).
azubi ALL=(root) NOPASSWD: /usr/sbin/usermod -L kehrwoche, /usr/sbin/usermod -U kehrwoche, /usr/bin/passwd -S kehrwoche
