# Vorlage für .env — Werte eintragen und als .env speichern. NIEMALS .env committen.
# Doku: docs/ENVIRONMENT.md (neue Variablen zuerst hier, dann src/env.d.ts, dann src/lib/env.ts)

# --- Required ---
# Eigene PostgreSQL-Datenbank (Runtime-only, nicht ins Client-Bundle)
# URL-kodieren, falls Benutzername oder Passwort Zeichen wie @, :, /, ? oder # enthalten.
DATABASE_URL=postgresql://alexle135:change_me_in_server_env@db:5432/alexle135
# Better Auth (Runtime-only)
BETTER_AUTH_SECRET=change-me-long-random-secret
BETTER_AUTH_URL=http://localhost:4321
# Google Gemini für /api/ai-tutor und /api/analyze (nur Server)
GEMINI_API_KEY=your_gemini_api_key

# --- Admin ---
# Komma-separierte Allowlist der Admin-E-Mails (fail-closed; Alternative: Better-Auth role=admin)
ADMIN_EMAILS=admin@example.com

# --- Optional ---
# Salt für IP-Hashing in contact_messages (openssl rand -hex 32); ohne Salt kein ip_hash
CONTACT_IP_SALT=
# Google Analytics 4 Measurement-ID
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- PostgreSQL ---
# Eigener Postgres-Container in docker-compose.prod.yml (Service "db").
# Die App führt versionierte SQL-Migrationen beim Start aus und beendet den Start bei Fehlern.
# Echte Werte kommen NIE hierher, sondern via Vaultwarden/Runtime-Env auf dem Server.
POSTGRES_DB=alexle135
POSTGRES_USER=alexle135
POSTGRES_PASSWORD=change_me_in_server_env
