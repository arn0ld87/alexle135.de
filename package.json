{
  "name": "alexle135-website",
  "version": "2.0.0",
  "description": "Alexander Schneider - IT-Systemintegration & DevOps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prepare": "node -e \"try{if(require('fs').existsSync('.git')){require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}}catch(e){}\"",
    "hooks:enable": "git config core.hooksPath .githooks && echo 'core.hooksPath -> .githooks aktiviert'",
    "start": "node ./dist/server/entry.mjs",
    "build": "astro build && node scripts/postbuild.js && (node scripts/bundle-size-report.js || true)",
    "preview": "astro preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "astro check",
    "check:html": "html-validate \"dist/client/**/*.html\"",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:dist": "pnpm check:html && pnpm check:links && pnpm check:a11y",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier scripts eslint.config.js prettier.config.cjs package.json --check",
    "format:fix": "prettier scripts eslint.config.js prettier.config.cjs package.json --write",
    "format:all": "prettier src scripts --check",
    "format:all:fix": "prettier src scripts --write",
    "bundle-report": "node scripts/bundle-size-report.js",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "db:migrate": "node scripts/run-postgres-migrations.mjs",
    "db:verify": "node scripts/verify-postgres-schema.mjs",
    "lighthouse:local": "astro build && npx --yes @lhci/cli collect --numberOfRuns=1 --startServerCommand='HOST=127.0.0.1 PORT=4321 node ./dist/server/entry.mjs' --startServerReadyPattern='listening on' --url=http://127.0.0.1:4321/ --url=http://127.0.0.1:4321/blog/ --url=http://127.0.0.1:4321/projekte/",
    "new:blog": "node scripts/new-blog.js",
    "new:projekt": "node scripts/new-project.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@webcontainer/api": "^1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "astro": "^7.3.8",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lucide-astro": "^0.556.0",
    "lucide-react": "^0.554.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.0",
    "simple-oauth2": "^5.0.0",
    "tailwind-merge": "^3.4.0",
    "terser": "^5.44.1",
    "v86": "0.5.471"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "axe-core": "^4.12.1",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "html-validate": "^11.5.5",
    "jsdom": "^27.2.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.1.11"
  }
}
